diff --git a/test/unit/slice_dotdot.sis b/test/unit/slice_dotdot.sis
new file mode 100644
index 0000000..3f56a89
--- /dev/null
+++ b/test/unit/slice_dotdot.sis
@@ -0,0 +1,11 @@
+% Parse + lower test for the `..` slice (read side).
+% A[i,j] = i*10+j (flat 2-D array_dv).  A[2, ..] = row 2 = DV_RANK_REDUCE(A, 2).
+% N=3  ->  A[2, ..] = [21, 22, 23]
+define main
+function main(N: integer returns array_dv[integer])
+  let
+    A := for i in 1, N cross j in 1, N returns array_dv of i*10 + j end for
+  in
+    A[2, ..]
+  end let
+end function
diff --git a/test/unit/slice_store.sis b/test/unit/slice_store.sis
new file mode 100644
index 0000000..f498908
--- /dev/null
+++ b/test/unit/slice_store.sis
@@ -0,0 +1,12 @@
+% Write-side test for `A[i, .. : row]` — replace row i with a row.
+% A[i,j]=i*10+j ; Z = a zero row.  A[2, .. : Z] -> row 2 becomes zeros.
+% N=3 -> flat result [11,12,13, 0,0,0, 31,32,33]
+define main
+function main(N: integer returns array_dv[integer])
+  let
+    A := for i in 1, N cross j in 1, N returns array_dv of i*10 + j end for;
+    Z := for j in 1, N returns array_dv of 0 end for
+  in
+    A[2, .. : Z]
+  end let
+end function
