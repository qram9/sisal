diff --git a/test/unit/red_argmax.sis b/test/unit/red_argmax.sis
new file mode 100644
index 0000000..74265a2
--- /dev/null
+++ b/test/unit/red_argmax.sis
@@ -0,0 +1,8 @@
+% Reduction: argmax of i*(N+1-i) -> the index i at the peak (returns the index).
+% N=5 -> values {5,8,9,8,5}, max=9 at i=3 -> argmax = 3
+define main
+function main(N: integer returns integer)
+  for i in 1, N
+  returns value of argmax i * (N + 1 - i)
+  end for
+end function
diff --git a/test/unit/red_argmin.sis b/test/unit/red_argmin.sis
new file mode 100644
index 0000000..2250950
--- /dev/null
+++ b/test/unit/red_argmin.sis
@@ -0,0 +1,10 @@
+% Reduction: argmin of i*i - 6*i  ( = (i-3)^2 - 9 )  -> the index i at the minimum.
+% N=5 -> values {-5,-8,-9,-8,-5}, min=-9 at i=3 -> argmin = 3
+% NB: the fold expr must NOT start with '(' -- `argmin (...)` parses as the ARGMIN
+% builtin function, not the `value of argmin` reduction op.
+define main
+function main(N: integer returns integer)
+  for i in 1, N
+  returns value of argmin i * i - 6 * i
+  end for
+end function
