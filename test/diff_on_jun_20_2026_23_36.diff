diff --git a/test/e2e/gaussj_dv_rr.sis b/test/e2e/gaussj_dv_rr.sis
new file mode 100644
index 0000000..8f984d2
--- /dev/null
+++ b/test/e2e/gaussj_dv_rr.sis
@@ -0,0 +1,97 @@
+% GAUSS-JORDAN — DV variant, explicit-rank conventions
+%
+%   A[i,j]                 LOAD a scalar  (index count == array rank)
+%   A[i]                   LOAD a scalar from a 1-D array
+%   DV_RANK_REDUCE(A, i)   READ a ROW     (drop the leading axis: rank-2 -> rank-1)
+%   DV_RANK_REDUCE(A,(i,j))READ a fiber from a 3-D array (drop two axes)
+%   A[i: v]                REPLACE — v's rank decides: scalar v -> element, row v -> row
+
+define Main
+
+
+% idfamax / idfmax take a 1-D row; A[i] is a scalar load.
+function idfamax( A: array_dv[double]; n: integer returns integer )
+  for i in 1, n
+  returns value of argmax abs(A[i])
+  end for
+end function
+
+function idfmax( A: array_dv[double]; n: integer returns integer )
+  for i in 1, n
+  returns value of argmax A[i]
+  end for
+end function
+
+
+function GetPivot( n: integer; A: array_dv[double]; PIVR: array_dv[integer]
+                   returns integer, integer )
+  let
+    cols, maxs :=
+      for i in 1, n
+        col, max := if PIVR[i] = 0 then
+                      let imax := idfamax( DV_RANK_REDUCE(A, i), n ) in   % row i (rank-reduce)
+                        imax, abs(A[i, imax])                            % element load
+                      end let
+                    else
+                      0, -1.0d0
+                    end if
+      returns array_dv of col
+              array_dv of max
+      end for;
+
+    irow := idfmax( maxs, n )
+  in
+    cols[irow], irow
+  end let
+end function
+
+
+function Compute( n, pvtrow: integer; Ain: array_dv[double]; Bin: array_dv[double]
+                  returns array_dv[double], array_dv[double] )
+  for i in 1, n
+    pvtele     := Ain[pvtrow, pvtrow];
+    Arow, Bele := if i = pvtrow then
+                    for j in 1, n
+                    returns array_dv of Ain[i, j] / pvtele
+                    end for,
+                    Bin[i] / pvtele
+                  else
+                    let multipler := Ain[i, pvtrow] / pvtele in
+                      for j in 1, n
+                      returns array_dv of Ain[i, j] - multipler * Ain[pvtrow, j]
+                      end for,
+                      Bin[i] - multipler * Bin[pvtrow]
+                    end let
+                  end if
+  returns array_dv of Arow
+          array_dv of Bele
+  end for
+end function
+
+
+function Main( n: integer; Ain: array_dv[double]; Bin: array_dv[double]
+               returns array_dv[double] )
+  for initial
+    I    := 0;
+    A, B := Ain, Bin;
+    PIVR := for j in 1, n returns array_dv of 0 end for
+  while I < n repeat
+    I    := old I + 1;
+    Icol, Irow := GetPivot( n, old A, old PIVR );
+
+    A1, B1 := if Icol ~= Irow then
+                % A 2-D: '..' makes the target a ROW (rank-1 slab) -> DV_RANK_REPLACE
+                old A[Icol, .. : DV_RANK_REDUCE(old A, Irow);
+                      Irow, .. : DV_RANK_REDUCE(old A, Icol)],
+                % B 1-D: values are SCALARS -> element replace
+                old B[Icol: old B[Irow];
+                      Irow: old B[Icol]]
+              else
+                old A, old B
+              end if;
+
+    PIVR := old PIVR[Icol: 1];
+    A, B := Compute( n, Icol, A1, B1 )
+  returns value of B
+  end for
+end function
diff --git a/test/e2e/gaussj_parts.sis b/test/e2e/gaussj_parts.sis
new file mode 100644
index 0000000..942998e
--- /dev/null
+++ b/test/e2e/gaussj_parts.sis
@@ -0,0 +1,69 @@
+% gaussj_parts.sis — regression for the gaussj component pieces verified bottom-up.
+% Each function was checked in isolation against a hand-computed result; together they
+% guard the new lower_forall paths: multi-output array gather, box-then-flatten
+% (array_dv of an inner-forall row), and multi-output function returns.
+define gaussj_parts
+
+% --- argmax over a 1-D row (the reduction path) ---
+function idfamax( A: array_dv[double]; n: integer returns integer )
+  for i in 1, n returns value of argmax abs(A[i]) end for
+end function
+
+function idfmax( A: array_dv[double]; n: integer returns integer )
+  for i in 1, n returns value of argmax A[i] end for
+end function
+
+% --- a forall returning TWO arrays (multi-output gather): P[i]=A[i]+1, Q[i]=A[i]*2 ---
+function gp_two( n: integer; A: array_dv[double]
+                 returns array_dv[double], array_dv[double] )
+  for i in 1, n
+  returns array_dv of A[i] + 1.0d0
+          array_dv of A[i] * 2.0d0
+  end for
+end function
+
+% --- array-of-rows gather (box-then-flatten): result is flat rank-2 i*10+j ---
+function gp_aor( n: integer returns array_dv[double] )
+  for i in 1, n
+    Arow := for j in 1, n returns array_dv of i*10.0d0 + j end for
+  returns array_dv of Arow
+  end for
+end function
+
+% --- GetPivot: nested forall building cols/maxs + the argmax helpers ---
+function GetPivot( n: integer; A: array_dv[double]; PIVR: array_dv[integer]
+                   returns integer, integer )
+  let cols, maxs :=
+      for i in 1, n
+        col, max := if PIVR[i] = 0 then
+                      let imax := idfamax( DV_RANK_REDUCE(A, i), n ) in
+                        imax, abs(A[i, imax])
+                      end let
+                    else 0, -1.0d0 end if
+      returns array_dv of col
+              array_dv of max
+      end for;
+    irow := idfmax( maxs, n )
+  in cols[irow], irow end let
+end function
+
+% --- Compute: one Gauss-Jordan elimination step (array row output + scalar output) ---
+function Compute( n, pvtrow: integer; Ain: array_dv[double]; Bin: array_dv[double]
+                  returns array_dv[double], array_dv[double] )
+  for i in 1, n
+    pvtele     := Ain[pvtrow, pvtrow];
+    Arow, Bele := if i = pvtrow then
+                    for j in 1, n returns array_dv of Ain[i, j] / pvtele end for,
+                    Bin[i] / pvtele
+                  else
+                    let multipler := Ain[i, pvtrow] / pvtele in
+                      for j in 1, n
+                      returns array_dv of Ain[i, j] - multipler * Ain[pvtrow, j]
+                      end for,
+                      Bin[i] - multipler * Bin[pvtrow]
+                    end let
+                  end if
+  returns array_dv of Arow
+          array_dv of Bele
+  end for
+end function
diff --git a/test/e2e/gen_extent.sis b/test/e2e/gen_extent.sis
new file mode 100644
index 0000000..3fde44e
--- /dev/null
+++ b/test/e2e/gen_extent.sis
@@ -0,0 +1,33 @@
+% gen_extent.sis — generator EXPRESSION-bound lowering (forall-extent-rework).
+% Each forall generator is lowered as a full graph (edge topo-walk): its bound
+% math (e.g. `n-1`, `m-1`) is declared in the forall scaffold BEFORE the result
+% alloc, and the RANGEGEN axis becomes the C `for` with lb/ub threaded from those
+% declared bound values.  Regression for the case where a SUBTRACT in the
+% generator was never lowered -> alloc/`for` referenced an undeclared C variable.
+
+define gen_extent
+
+% single-level expression upper bound: i runs 1..(n-1).
+% n=5 -> i in 1..4 -> [1,4,9,16].
+function genext_sub(n: integer returns array[integer])
+  for i in 1, n-1
+  returns array of i * i
+  end for
+end function
+
+% expression LOWER bound too: i runs (n-3)..n.
+% n=6 -> i in 3..6 -> [3,4,5,6].
+function genext_lb(n: integer returns array[integer])
+  for i in n-3, n
+  returns array of i
+  end for
+end function
+
+% cross nest with an expression bound on the INNER axis: i in 1..n, j in 1..(m-1).
+% The inner `m-1` is loop-invariant, hoisted to the scaffold ahead of the rank-2
+% alloc.  n=2,m=4 -> j in 1..3 -> rank2 [2,3]: 11 12 13 21 22 23.
+function genext_cross(n: integer; m: integer returns array[array[integer]])
+  for i in 1, n cross j in 1, m-1
+  returns array of i * 10 + j
+  end for
+end function
