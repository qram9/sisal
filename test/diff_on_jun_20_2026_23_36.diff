+            else false in
+          let c2 =
+            if sym = AELEMENT || sym = DV_ELEMENT || sym = DV_RANK_REDUCE || sym = DV_RANK_REPLACE || sym = DV_LOAD_LINEAR || sym = DV_OFFSET_AT || sym = DV_DIMENSION || sym = AREPLACE
+            then let in1 = get_ty cur_gid nid 1 `In in
