% Origin: test/unit/mat_ops.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
Define Main

type RealArray = array_dv[real];
type DoubleArray = array_dv[double];
type IntArray = array_dv[integer];

function Main(N : integer returns RealArray, DoubleArray, IntArray)
  let
    R := array_dv RealArray [1: 0.0, 0.0, 0.0]; 
    D := array_dv DoubleArray [1: 0.0, 0.0, 0.0];
    I := array_dv IntArray [1: 0, 0, 0];
  in
    R, D, I
  end let
end function
