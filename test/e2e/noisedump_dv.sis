% Origin: test/unit/noisedump.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% noisedump -- render a 0/1 matrix as a character picture, from
% test/unit/noisedump.sis.
%
% Promoted for the OUTPUT TYPE: `stream[character]`.  Nothing else in e2e uses a
% character stream -- streams here carry integers, floats or records, and the
% only other character work is the array side, where array_fill on a 1-byte
% element is still miscompiled (see arsieve_dv, which had to switch to integer
% flags).  A character STREAM is a different path and this pins it.
%
% What it does: Prepare appends a 3 to every row and catenates the rows into one
% flat vector, then main maps 1 -> '*', 0 -> ' ' and anything else -> newline,
% so the appended 3s become the line breaks.  A 2x3 matrix
%
%     1 0 1        "* *"
%     0 1 0   ->   " * "
%
% comes out as the eight characters `* *\n * \n`.
%
% Also exercised, though covered elsewhere: `value of catenate` (10+ e2e files
% use it) and row iteration over a rank-2 array_dv -- `for E in M` binds a ROW
% via the row iterator, which is the single-index scatter left untouched by the
% multi-index `at` work.
%
% The reference is the exact character sequence, computed from the input matrix
% rather than from the program: every 1 must be a star, every 0 a space, and a
% newline must appear only at a row boundary.  A wrong row length or a dropped
% catenate shows up as a misplaced newline.

define Main

type Vector = array_dv[ integer ];
type Matrix = array_dv[ Vector ];
type Output = stream[ character ];

function Prepare( M: Matrix returns Vector )
   for E in M
      V := E || array_dv Vector[1:3];
   returns value of catenate V
   end for
end function

function main ( M: Matrix returns Output )
   for E in Prepare( M )
      V := if ( E = 1 ) then '*'
	   elseif ( E = 0 ) then ' '
	   else '\n'
	   end if;
   returns stream of V
   end for
end function
