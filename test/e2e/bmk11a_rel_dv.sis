% Origin: test/unit/bmk11a.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% BMK11A, part 3 of 4 -- `parmvr`, the RELATIVISTIC particle push.
%
% (The plan said three parts.  Reading the whole file for part 2 turned up a
% third mover, parmvr, sitting between parmov and main -- so the integrated
% driver becomes part 4 and this is part 3.)
%
% parmvr is parmov with special relativity folded in.  The particle state is
% PROPER velocity u = gamma*v, so the Lorentz factor has to be recovered from it
% at two separate points and the two are not interchangeable:
%
%     ga  = 1/sqrt(u.u + 1)   from the OLD u, used to scale the field kick
%     ga1 = 1/sqrt(u'.u' + 1) from the NEW u, used to convert u' back to a
%                             coordinate velocity for the position advance
%
% Both are stored INVERTED -- `ga` is 1/gamma, not gamma -- which is why the
% position advance reads `ga1[l]*dt*vx[l]`: that is u/gamma, an ordinary
% velocity.  Reading either as gamma rather than 1/gamma still typechecks and
% still runs, so the harness pins the direction explicitly.
%
% Against parmov, the velocity advance gains gamma factors:
%     hha   = hh*ga        hhasq = hh*ga^2
%     c     = ga*( 1 - hhasq*(u.E) )      <- new, no counterpart in parmov
%     f     = 1 - h*hhasq*(B.B)
%     g     = hhasq*(u.B)
%     vxa   = c*ux + hha*Ex                <- parmov has plain ux + hh*Ex
% and the rotation itself is unchanged.  Setting ga = 1 and c = 1 recovers
% parmov exactly, which is the cleanest statement of what relativistic means
% here and is checked directly below.
%
% `exp(x, y)` is POW, as established in part 2.
%
% THE ARRAY REWRITE is again just `array` -> `array_dv` plus the gather keyword.
%
% THE SAME PRE-PUSH INDEX QUIRK as part 2 survives here: the current deposition
% uses the HALF-time weights w11..w41 with the PRE-PUSH index `ij`.  It also
% mixes time levels in the velocity -- xmult from the half-time vxh1, but ymult
% and zmult from the whole-time vy and vz.  Preserved as written.
%
% THREE EXTRA OUTPUTS: sumf1/2/3, which sum the INPUT velocities, not the
% output ones -- a diagnostic of the state entering the push.
%
% THE ORACLE:
%   * NON-RELATIVISTIC LIMIT: at u << 1, ga -> 1 and parmvr's answer approaches
%     parmov's.  Run both movers on the same slow data and watch the gap close
%     as the velocities shrink -- this is the check that the gamma factors are
%     in the right PLACES, not just present.
%   * ga IS INVERTED: for u.u = 3, gamma = 2, so the stored ga must be 0.5.  A
%     transcription that dropped the reciprocal would give 2 and still run.
%   * ZERO fields: the kick vanishes, but positions still advance by
%     ga1*dt*u -- STRICTLY LESS than dt*u for relativistic particles, unlike
%     parmov where the two agree.  This separates the two movers on data where
%     everything else is identical.
%   * sumf sums the INPUT velocities: perturbing only the fields (which change
%     the outputs) must leave all three sums untouched.
%   * a particle with x < 0 is inactive.
%   * the full push, cell by cell, against a transcription.

define main

type OneD = array_dv[double];
type OneI = array_dv[integer];

function BCNDUpdate2( lb,ibcdl:integer; x,xh,vx,vxh:OneD; 
                      xleft, xlef2:double 
                      returns OneD, OneD, OneD, OneD )
  if ( x[lb] >= xleft ) then x, vx, xh, vxh                % GOTO 60
  elseif ( ibcdl > 1 ) then                                % GOTO 30
    x, vx, xh, vxh                                         % call BCNDL GOTO 60
  else
    x[lb:xlef2 - x[lb]], vx[lb:-vx[lb]],
    if ( xh[lb] >= xleft ) then xh, vxh                    % GOTO 60
    else xh[lb:xlef2-xh[lb]], vxh[lb:-vxh[lb]] 
    end if
  end if
end function


function BCNDUpdate1( lb:integer; z_IN,zh_IN:OneD; zmax:double 
                     returns OneD, OneD )
let
  z  := z_IN[lb];
  zh := zh_IN[lb];
  
  zv, zhv := if ( z < zmax ) then                             % GOTO 70

               if ( z >= 0.0D0 ) then z, zh                   % GOTO 80
               else
                 let
                   zv := z + zmax;
                 in
                   if ( zh >= 0.0D0 ) then zv, zh             % GOTO 80
                   else zv, zh + zmax
                   end if
                 end let
               end if

             else

               let
                 zv1 := z - zmax;
               in
                 if ( zh < zmax ) then                         % GOTO 70
                   if ( zv1 >= 0.0D0 ) then zv1, zh            % GOTO 80
                   else
                     if ( zh >= 0.0D0 ) then zv1 + zmax, zh    % GOTO 80
                     else zv1 + zmax, zh + zmax
                     end if
                   end if
                 else zv1, zh - zmax
                 end if
               end let

             end if;
in
  z_IN[lb:zv], zh_IN[lb:zhv]
end let
end function


function BCND( xleft,xright:double;
               l3,jb:integer;
               kbound,ibcdr,ibcdl:integer;
               ib:OneI;
               yIN,yhIN,xIN,xhIN,vxIN,vxhIN:OneD;
               xmax,ymax:double;
               returns OneD, OneD, OneD, OneD, OneD, OneD )
let
  xlef2 := 2.0D0 * xleft;
  xrit2 := 2.0D0 * xright;
in
  for initial
    l   := l3;

    y   := yIN;
    yh  := yhIN;
    x   := xIN;
    xh  := xhIN;
    vx  := vxIN;
    vxh := vxhIN;

  while ( l <= jb ) repeat
    l  := old l + 1;
    lb := ib[old l];

    x, xh, vx, vxh :=
      if ( kbound = 0 ) then                                % GOTO 40

        BCNDUpdate1( lb, old x,old xh, xmax ), old vx, old vxh

      elseif ( old x[lb] < xright ) then                    % GOTO 20

        BCNDUpdate2( lb,ibcdl, old x,old xh,old vx,old vxh, xleft,xlef2 )

      elseif ( ibcdr > 1 ) then                             % GOTO 10

        old x, old xh, old vx, old vxh                      % call BCNDL GOTO 60

      else

        let
          x1  := old x[lb: xrit2-old x[lb]];
          vx1 := old vx[lb: -old vx[lb]]
        in
          if ( old xh[lb] < xright ) then % GOTO 20
            BCNDUpdate2( lb,ibcdl, x1,old xh,vx1, old vxh, xleft,xlef2 )
          else
            x1, old xh[lb: xrit2-old xh[lb]], vx1, old vxh[lb:-old vxh[lb]] 
          end if
        end let

      end if;

% 60:
    y, yh := BCNDUpdate1( lb, old y,old yh, ymax );
%               yIN,yhIN,xIN,xhIN,vxIN,vxhIN:OneD;
  returns value of y value of yh
          value of x value of xh
          value of vx value of vxh
  end for
end let
end function

function parmvr( dt,qmult,wmult:double;
                 kbound,ibcdr,ibcdl,l3,l4:integer;
                 ex,ey,ez,bx,by,bz:OneD;
                 xmax,ymax,xright,xleft,hxi,hyi:double; nx2:integer;
                 vzIN, yIN,xIN,vxIN,vyIN,cx,cy,cz,q:OneD;
                 returns OneD, OneD, OneD, OneD,
			 OneD, OneD, OneD, OneD, OneD,
			 double, double, double )
let
  h1 := dt*qmult/wmult;
  hh := 0.5D0*h1;

  h := for l in l3,l4
       returns array_dv of if (xIN[l] < 0.0D0 ) then 0.0D0 else h1 end if
       end for;

%
%    calculate old gammas.
%
  ga := for l in l3,l4
          ga := exp(vxIN[l],2.0D0) + 
		exp(vyIN[l],2.0D0) + exp(vzIN[l],2.0D0) + 1.0D0;
          ga1 := sqrt(ga);
          ga2 := 1.0D0/ga1;
	returns array_dv of ga2
	end for;

%
%    calculate area weight vectors
%

  i,  fx, fy, ij, 
  w1, w2, w3, w4 := for l in l3,l4
                      rx  := hxi*xIN[l] + 1.5D0;
                      ry  := hyi*yIN[l] + 1.5D0;
                      i   := integer(trunc(rx));            % i = rx
                      fx  := rx - double_real(trunc(rx)); % aint
                      fxc := 1.0D0 - fx;
                      j   := integer(trunc(ry));            % j = ry
                      fy  := ry - double_real(trunc(ry)); % aint
                      fyc := 1.0D0 - fy;
                    returns array_dv of i
                            array_dv of fx
                            array_dv of fy
                            array_dv of i + nx2*(j-1)
                            array_dv of fxc*fyc
                            array_dv of fx*fyc
                            array_dv of fxc*fy
                            array_dv of fx*fy
                    end for;

%  fetch ex field vector
%    calculate average field on particle
%
%     1ef4,nx2,324)
%
  exa, eya, eza,
  bxa, bya, bza := for l in l3,l4
                     ijl   := ij[l];
                     ijl1  := ijl + 1;
                     ijln  := ijl + nx2;
                     ijln1 := ijln + 1;
                   returns array_dv of w1[l]*ex[ijl] + w2[l]*ex[ijl1] + 
				    w3[l]*ex[ijln] + w4[l]*ex[ijln1]
                           array_dv of w1[l]*ey[ijl] + w2[l]*ey[ijl1] + w3[l]*
				    ey[ijln] + w4[l]*ey[ijln1]
                           array_dv of w1[l]*ez[ijl] + w2[l]*ez[ijl1] + w3[l]*
				    ez[ijln] + w4[l]*ez[ijln1]
                           array_dv of w1[l]*bx[ijl] + w2[l]*bx[ijl1] + w3[l]*
				    bx[ijln] +w4[l]*bx[ijln1]
                           array_dv of w1[l]*by[ijl] + w2[l]*by[ijl1] + w3[l]*
				    by[ijln] +w4[l]*by[ijln1]
                           array_dv of w1[l]*bz[ijl] + w2[l]*bz[ijl1] + w3[l]*
				    bz[ijln] +w4[l]*bz[ijln1]
                   end for;

%
%  advance three components of momentum
%
  vx, vy, vz, sumf1,
  sumf2, sumf3 := for l in l3,l4
                    hha   := hh*ga[l];
                    hhasq := hha*ga[l];
                    c     := ga[l]*(1.0D0-hhasq*(vxIN[l]*exa[l]+vyIN[l]*eya[l]+
			     vzIN[l]*eza[l]));

                    f := 1.0D0 - h[l]*hhasq*(exp(bxa[l],2.0D0)+
			 exp(bya[l],2.0D0)+exp(bza[l],2.0D0));

                    g := hhasq*(vxIN[l]*bxa[l]+vyIN[l]*bya[l]+vzIN[l]*bza[l]);

                    vxa := c*vxIN[l] + hha*exa[l];
                    vya := c*vyIN[l] + hha*eya[l];
                    vza := c*vzIN[l] + hha*eza[l];
                  returns array_dv of f*vxIN[l] + h[l]*(exa[l]+g*bxa[l]+vya*bza[l]
                                   -vza*bya[l])
                          array_dv of f*vyIN[l] + h[l]*(eya[l]+g*bya[l]+vza*bxa[l]
                                   -vxa*bza[l])
                          array_dv of f*vzIN[l] + h[l]*(eza[l]+g*bza[l]+vxa*bya[l]
                                   -vya*bxa[l])
                          value of sum vxIN[l]
                          value of sum vyIN[l]
                          value of sum vzIN[l]
	          end for;
%
%   compute new gammas
%
  ga1 := for l in l3,l4
           ga   := exp(vx[l],2.0D0) + exp(vy[l],2.0D0) + exp(vz[l],2.0D0) 
		   + 1.0D0;
           ga1  := sqrt(ga);
           ga2  := 1.0D0/ga1;
	 returns array_dv of ga2
	 end for;
           
%
%   advance whole and half-time positions.
%
  vxh, xh, 
  x, yh, y := for l in l3,l4
                   dx := if (xIN[l] < 0.0D0) then 0.0D0 
			 else ga1[l]*dt*vx[l] end if;
                   dy := if (xIN[l] < 0.0D0) then 0.0D0 
			 else ga1[l]*dt*vy[l] end if;
                 returns array_dv of vx[l]
                         array_dv of xIN[l] + 0.5D0*dx
                         array_dv of xIN[l] + dx
                         array_dv of yIN[l] + 0.5D0*dy
                         array_dv of yIN[l] + dy
		  end for;
%
%   check for particle boundary crossings
%
  jb, ib := for l in l3,l4
              ib := if (x[l] >= xright) then 1
                    elseif (x[l] < xleft) then 1
                    elseif (y[l] < 0.0D0) then 1
                    elseif (y[l] >= ymax) then 1
                    else 0
                    end if;
            returns value of sum ib
                    array_dv of ib
            end for;

  y1, yh1, x1, 
  xh1, vx1, vxh1 := if ( jb > 0 ) then
                      BCND( xleft,xright, l3,jb, kbound,ibcdr,ibcdl, ib,
                            y, yh, x, xh, vx, vxh, xmax, ymax )
                    else
                      y, yh, x, xh, vx, vxh
                    end if;
%
%    calculate area weight vectors at half-time step.
%
  i1, fx1, fy1, ij1,
  w11, w21, w31, w41 := for l in l3,l4
                          rx  := hxi*xh1[l] + 1.5D0;
                          ry  := hyi*yh1[l] + 1.5D0;
                          i   := integer(trunc(rx));
                          fx  := rx - double_real(trunc(rx));
                          fxc := 1.0D0 - fx;
                          j   := integer(trunc(ry));
                          fy  := ry - double_real(trunc(ry));
                          fyc := 1.0D0 - fy;
                        returns array_dv of i
                                array_dv of fx
                                array_dv of fy
                                array_dv of i + nx2*(j-1)
                                array_dv of fxc*fyc
                                array_dv of fx*fyc
                                array_dv of fxc*fy
                                array_dv of fx*fy
                         end for;
%
%  area weight particles onto current grids
%

  xmult1,xmult2,xmult3,xmult4,
  ymult1,ymult2,ymult3,ymult4,
  zmult1,zmult2,zmult3,zmult4,
  qmlt  := for l in l3,l4 
             qmlt  := if (x1[l] < 0.0D0 ) then 0.0D0 else qmult end if;
	     qma   := qmlt*ga1[l];
             xmult := qma*vxh1[l];
             ymult := qma*vy[l];
             zmult := qma*vz[l];
	   returns array_dv of xmult*w11[l] array_dv of xmult*w21[l] 
		   array_dv of xmult*w31[l] array_dv of xmult*w41[l]
		   array_dv of ymult*w11[l] array_dv of ymult*w21[l] 
		   array_dv of ymult*w31[l] array_dv of ymult*w41[l]
		   array_dv of zmult*w11[l] array_dv of zmult*w21[l] 
		   array_dv of zmult*w31[l] array_dv of zmult*w41[l]
	           array_dv of qmlt
           end for;

  cx1, cy1, cz1 :=
      for initial
	l := l3;
	cx1 := cx; cy1 := cy; cz1 := cz;
      while ( l <= l4 ) repeat
	l := old l + 1;

        ijl   := ij[old l];
        ijl1  := ijl + 1;
        ijln  := ijl + nx2;
        ijln1 := ijln + 1;

        cx1a := old cx1[ijl: old cx1[ijl] + xmult1[old l]];
        cx1b := cx1a[ijl1  : cx1a[ijl1] + xmult2[old l]];
        cx1c := cx1b[ijln  : cx1b[ijln] + xmult3[old l]];
        cx1  := cx1c[ijln1 : cx1c[ijln1] + xmult4[old l]];

        cy1a := old cy1[ijl: old cy1[ijl] + ymult1[old l]];
        cy1b := cy1a[ijl1: cy1a[ijl1] + ymult2[old l]];
        cy1c := cy1b[ijln: cy1b[ijln] + ymult3[old l]];
        cy1  := cy1c[ijln1: cy1c[ijln1] + ymult4[old l]];

        cz1a := old cz1[ijl: old cz1[ijl] + zmult1[old l]];
        cz1b := cz1a[ijl1: cz1a[ijl1] + zmult2[old l]];
        cz1c := cz1b[ijln: cz1b[ijln] + zmult3[old l]];
        cz1  := cz1c[ijln1: cz1c[ijln1] + zmult4[old l]];
      returns value of cx1
	      value of cy1
	      value of cz1
      end for;

%
%  calculate area weight vectors at whole time
%
  i2, fx2, fy2, ij2,
  w12, w22, w32, w42 := for l in l3,l4
                          rx  := hxi*x1[l] + 1.5D0;
                          ry  := hyi*y1[l] + 1.5D0;
                          i   := integer(trunc(rx));
                          fx  := rx - double_real(trunc(rx));
                          fxc := 1.0D0 - fx;
                          j   := integer(trunc(ry));
                          fy  := ry - double_real(trunc(ry));
                          fyc := 1.0D0 - fy;
                        returns array_dv of i
                                array_dv of fx
                                array_dv of fy
                                array_dv of i + nx2*(j-1)
                                array_dv of fxc*fyc
                                array_dv of fx*fyc
                                array_dv of fxc*fy
                                array_dv of fx*fy
                         end for;

% 
%  area weight particles onto charge grid 
%
  s1, s2, s3, s4 := for l in l3,l4
                    returns array_dv of w12[l]*qmlt[l]
                            array_dv of w22[l]*qmlt[l]
                            array_dv of w32[l]*qmlt[l]
                            array_dv of w42[l]*qmlt[l]
                    end for;

  q1 := for initial
          l  := l3;
          q1 := q;
        while ( l <= l4 ) repeat
          l  := old l + 1;

          ijl   := ij2[old l];
          ijl1  := ijl + 1;
          ijln  := ijl + nx2;
          ijln1 := ijln + 1;

          q1a := old q1[ijl:  old q1[ijl] + s1[old l]];
          q1b := q1a[ijl1: q1a[ijl1] + s2[old l]];
          q1c := q1b[ijln: q1b[ijln] + s3[old l]];

          q1  := q1c[ijln1: q1c[ijln1] + s4[old l]];
        returns value of q1
        end for;
in
  y1, x1, vz, vx1, vy, cx1, cy1, cz1, q1,
  sumf1, sumf2, sumf3
end let
end function

% parmvr's own outputs, plus the three sums, exposed for the harness
function main( ex, ey, ez, bx, by, bz : OneD;
               vz, y, x, vx, vy, cx, cy, cz, q : OneD;
               l3, l4, nx2, kbound, ibcdr, ibcdl : integer;
               dt, qmult, wmult, xmax, ymax, xright, xleft, hxi, hyi : double
      returns OneD, OneD, OneD, OneD, OneD, OneD, OneD, OneD, OneD,
              double, double, double )
  parmvr( dt, qmult, wmult, kbound, ibcdr, ibcdl, l3, l4,
          ex, ey, ez, bx, by, bz,
          xmax, ymax, xright, xleft, hxi, hyi, nx2,
          vz, y, x, vx, vy, cx, cy, cz, q )
end function
