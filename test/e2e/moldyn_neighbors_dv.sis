% Origin: test/unit/moldyn.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% MOLDYN_NEIGHBORS — DV variant of Get_Neighbor_Lists / Get_Neighbors /
% Separation from unit/moldyn.sis.  These BUILD the ragged neighbour structure
% that moldyn_force_dv then consumes: for each particle, which other particles
% lie within the type-pair dissociation radius Rc.
%
% Get_Neighbors is kept exactly as the original writes it -- a masked gather on
% a SINGLE generator.  That is legal and compacts correctly: the survivor count
% is data-dependent, and a lone generator's mask is counted once, so the row
% comes out packed with length = the number of neighbours.
%
% Get_Neighbor_Lists is what cannot survive verbatim.  It gathers those rows
% with `array_dv of N_LIST`, and since each row has a different length the result
% is ragged -- no array_dv shape.  It becomes the padded rank-2 NEIGHBORS plus
% the NCOUNT extent vector that the force core already expects, the same
% treatment GenLinks' layers got.
%
% HOW THE PADDED ROW IS BUILT.  The obvious spelling -- take the packed row and
% append zeros, `N_LIST || Zeros(MaxN - array_size(N_LIST))` -- is what this
% file now uses.  It used to be unwritable: appending an EMPTY array bumped
% dims[0] by a phantom row while size grew by nothing, so a particle with the
% maximum number of neighbours (no padding needed) left the enclosing gather
% reporting dims[1] = true_length + 1, and every later row was then read at the
% wrong offset.  The data was packed correctly throughout -- only the
% descriptor lied -- which is why it went unnoticed until a consumer indexed by
% dims[1].
%
% That is fixed in the runtime: `a || empty` is the identity, and `||` now
% requires its operands to conform along every axis but the one being extended,
% as numpy's concatenate does.  This file is the benchmark-scale exercise of
% that fix -- case B below gives every particle the maximum neighbour count, so
% EVERY pad is empty, and case A makes only the first row full.
%
% The scan that used to build the rectangle (Kth_Neighbor, slot K holds the
% K-th qualifying particle) is kept as NEIGHBORS_SCAN.  Two independent
% spellings of the same rectangle must agree element for element, so a
% regression in either shows up as a disagreement rather than as a plausible
% wrong answer.

define Main

type Reals = array_dv [real];
type Ints = array_dv [integer];

type POS_REC = record [X, Y, Z : Reals];
type VEL_REC = record [VX, VY, VZ : Reals];

type ENSEMBLE_STATE_REC = record
     [ TOUT : real;
       CURRENT_STEP : real;
       CURRENT_ERR : real;
       ENSEMBLE_SIZE : integer;
       POSITIONS : POS_REC;
       VELOCITIES : VEL_REC;
       TYPES : Ints ];

type PROBLEM_DATA_REC = record
     [ NUMBER_OF_TYPES : integer;
       A1 : Reals; B1 : Reals; Re : Reals; Rc : Reals;   % rank 2, by type pair
       ALFA : Reals; C0 : Reals;
       MASS : Reals;
       DELTA_T : real; ENDTIME : real; TOLERANCE : real ];

function square (X : real returns real)
   X * X
end function

function Sep_Rad (X1, Y1, Z1, X2, Y2, Z2 : real returns real)
   let
      X_DIFF_SQ := square(X1 - X2);
      Y_DIFF_SQ := square(Y1 - Y2);
      Z_DIFF_SQ := square(Z1 - Z2)
   in
      sqrt( X_DIFF_SQ + Y_DIFF_SQ + Z_DIFF_SQ )
   end let
end function

function Separation (PARTICLE, OTHER_PARTICLE : integer;
                     ENSEMBLE : ENSEMBLE_STATE_REC
                    returns real)
   let
      X1 := ENSEMBLE.POSITIONS.X[ PARTICLE ];
      Y1 := ENSEMBLE.POSITIONS.Y[ PARTICLE ];
      Z1 := ENSEMBLE.POSITIONS.Z[ PARTICLE ];
      X2 := ENSEMBLE.POSITIONS.X[ OTHER_PARTICLE ];
      Y2 := ENSEMBLE.POSITIONS.Y[ OTHER_PARTICLE ];
      Z2 := ENSEMBLE.POSITIONS.Z[ OTHER_PARTICLE ]
   in
      Sep_Rad( X1, Y1, Z1, X2, Y2, Z2 )
   end let
end function

% true when OTHER_PARTICLE is a neighbour of PARTICLE -- the original's mask,
% factored out so the packed row and the padded row cannot drift apart
function Is_Neighbor (PARTICLE, OTHER_PARTICLE : integer;
                      ENSEMBLE : ENSEMBLE_STATE_REC;
                      PROBLEM_DATA : PROBLEM_DATA_REC
                     returns boolean)
   let
      T1 : integer := ENSEMBLE.TYPES[ PARTICLE ];
      T2 : integer := ENSEMBLE.TYPES[ OTHER_PARTICLE ];
      RC : real := PROBLEM_DATA.Rc[ T1, T2 ]
   in
      OTHER_PARTICLE ~= PARTICLE &
      Separation( PARTICLE, OTHER_PARTICLE, ENSEMBLE ) <= RC
   end let
end function

% the original, verbatim in shape: a masked gather on a single generator, so
% the row comes out PACKED with length = the neighbour count
function Get_Neighbors (PARTICLE : integer;
                        ENSEMBLE : ENSEMBLE_STATE_REC;
                        PROBLEM_DATA : PROBLEM_DATA_REC
                       returns Ints)
   for OTHER_PARTICLE in 1, ENSEMBLE.ENSEMBLE_SIZE
   returns
      array_dv of OTHER_PARTICLE
      when Is_Neighbor( PARTICLE, OTHER_PARTICLE, ENSEMBLE, PROBLEM_DATA )
   end for
end function

function Zeros (N : integer returns Ints)
   for K in 1, N returns array_dv of 0 end for
end function

% the K-th qualifying particle for PARTICLE, or 0 if it has fewer than K
function Kth_Neighbor (PARTICLE, K : integer;
                       ENSEMBLE : ENSEMBLE_STATE_REC;
                       PROBLEM_DATA : PROBLEM_DATA_REC
                      returns integer)
   for initial
      Q := 0;
      SEEN := 0;
      FOUND := 0;
   while (Q < ENSEMBLE.ENSEMBLE_SIZE) & (FOUND = 0)
   repeat
      Q := old Q + 1;
      HIT := Is_Neighbor( PARTICLE, Q, ENSEMBLE, PROBLEM_DATA );
      SEEN := if HIT then old SEEN + 1 else old SEEN end if;
      FOUND := if (HIT & (SEEN = K)) then Q else old FOUND end if;
   returns
      value of FOUND
   end for
end function

% the assembled structure: a rectangular rank-2 NEIGHBORS padded to the worst
% case, plus NCOUNT giving each row's valid extent
function Get_Neighbor_Lists (ENSEMBLE : ENSEMBLE_STATE_REC;
                             PROBLEM_DATA : PROBLEM_DATA_REC
                            returns Ints, Ints, Ints)
   let
      NP := ENSEMBLE.ENSEMBLE_SIZE;
      MaxN := NP - 1;        % a particle can neighbour every other one

      % THE NATURAL SPELLING: take the packed row and append zeros.  This is
      % what the bug used to make unwritable.
      NEIGHBORS :=
         for PARTICLE in 1, NP
            N_LIST := Get_Neighbors( PARTICLE, ENSEMBLE, PROBLEM_DATA );
         returns
            array_dv of N_LIST || Zeros( MaxN - array_size( N_LIST ) )
         end for;

      % the same rectangle built by an independent scan, kept as a cross-check
      NEIGHBORS_SCAN :=
         for PARTICLE in 1, NP cross
             K in 1, MaxN
         returns
            array_dv of Kth_Neighbor( PARTICLE, K, ENSEMBLE, PROBLEM_DATA )
         end for;

      % the count comes from the original packed row, so the two spellings of
      % "who are my neighbours" are cross-checked against each other
      NCOUNT :=
         for PARTICLE in 1, NP
            N_LIST := Get_Neighbors( PARTICLE, ENSEMBLE, PROBLEM_DATA );
         returns
            array_dv of array_size( N_LIST )
         end for;
   in
      NEIGHBORS, NCOUNT, NEIGHBORS_SCAN
   end let
end function

function Main (ENSEMBLE : ENSEMBLE_STATE_REC;
               PROBLEM_DATA : PROBLEM_DATA_REC
              returns
               Ints,        % NEIGHBORS, rank 2: particle x padded slot
               Ints,        % NCOUNT, neighbours per particle
               Ints)        % the same rectangle via an independent scan
   Get_Neighbor_Lists( ENSEMBLE, PROBLEM_DATA )
end function
