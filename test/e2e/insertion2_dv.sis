% INSERTION2 — DV variant of unit/insertion2.sis (insertion sort with the
% early-exit inner walk; the original's "this is not insertion sort" comment
% notwithstanding, the early exit is correct because the prefix is sorted).
% OneDim -> array_dv[double_real]; pins nested for-initial while loops with
% a two-value multibind whose arms mix a multi-value replace swap
% (B[J-1: B[J], B[J-1]]) against an identity carry.

define Main

type OneDim = array_dv[ double_real ]

function Main( N : integer; Input: OneDim returns OneDim )
  for initial
    I := 2;
    A := Input;
  while I <= N repeat
    A :=
      for initial
        J := old I;
        B := old A;
      while ( J > 1 ) repeat
        J, B := if ( old B[ old J ] < old B[ old J-1 ]) then
                  old J - 1,
                  old B[ old J - 1: old B[ old J ], old B[ old J - 1 ] ]
                else
                  1, old B
                end if;
      returns value of B
      end for;
    I := old I + 1;
  returns value of A
  end for
end function % Main
