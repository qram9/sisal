define Main

type IntArr = array_dv[ integer ];
type MyRec  = record[ a: integer; b: double_real ];

function Main(
    selector: integer;
    flag: boolean;
    outer_scalar: integer;
    outer_arr: IntArr;
    outer_rec: MyRec
    returns integer, IntArr, MyRec
)
    if selector = 1 then
        if flag then
            outer_scalar + 10, outer_arr, outer_rec
        else
            outer_scalar + 20, outer_arr, record MyRec[ a: outer_rec.a + 1; b: outer_rec.b ]
        end if
    elseif selector = 2 then
        outer_scalar * 2, outer_arr, outer_rec
    else
        0, array_dv IntArr[ 1: 0 ], record MyRec[ a: 0; b: 0.0d0 ]
    end if
end function
