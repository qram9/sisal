% Origin: test/unit/basic.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
type dvi = array_dv[integer]

function negate(A : dvi returns dvi)
  let N := array_size(A) in
  for I in 1, N
    Val := -A[I]
  returns array_dv of Val
  end for
  end let
end function
