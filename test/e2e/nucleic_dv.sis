% NUCLEIC (Pseudoknot) -- the whole benchmark on the SoA port.
%
% Data: the four base tables + the two inline groups + the 7 named transforms,
% all mechanically transposed from nucleic.sis and verified element-for-element.
% Engine: the real 23-level pseudoknot_domains dispatch, the six constraint
% builders, and the result reduction.
%
% Two faithful simplifications the persistent representation allows:
%  * the stack is the ML cons-list, so `array_remh` (pop) is FREE -- a caller
%    simply keeps its own `stk`, which the recursion cannot have changed.
%  * most_distant_atom is a MAX over every var of every solution, so instead of
%    materialising `solutions` (a list of lists) the search FOLDS the max as it
%    goes: a completed placement contributes max-over-its-stack, and branches
%    combine with max.  Same value, no accumulation.
%
% Indices: nucleic is 0-based, this port is 1-based, so every literal index is
% +1 (tfos[0]->tf row 1, nucs[3,0]->ns[4] row 1, params[54]->params[55], ...).
define main

type Flat   = array_dv[double];
type OneDim = array_dv[double];
type SoA    = record[ typ: OneDim; dgf: OneDim; p275: OneDim; p180: OneDim;
                      p60: OneDim; params: OneDim; uniontype: OneDim ];
type Nuc2   = array_dv[SoA];      % nucs: the 6 groups
type Tfo1   = array_dv[double];   % tfos: 7 x 12, rank-2

function init_A( returns SoA )
  record SoA [
    typ:    array_dv OneDim [1: 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0];
