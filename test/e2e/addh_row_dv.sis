% APPENDING A ROW TO A MATRIX WITH `||`.
%
% `||` on array_dv is concatenation along the FIRST axis, and it is rank
% polymorphic in exactly the way numpy's concatenate-along-axis-0 is:
%
%   rank 2 || rank 1   -- append ONE row      (3x5 || 5   -> 4x5)   np.vstack
%   rank 2 || rank 2   -- append a STACK      (3x5 || 2x5 -> 5x5)   np.concatenate
%   rank 1 || rank 1   -- flat concatenation  (3   || 2   -> 5)
%
% The machinery for the first two was always there -- addh_arr's add_rows picks
% b.dims[0] for a same-rank operand and 1 for a lower-rank one -- but it never
% checked that the operands CONFORM, so a mismatch was silent and produced a
% descriptor whose dims disagreed with its own size.  Appending a 3-wide row to
% a 3x5 reported dims 4 x 5 (20 slots) while size stayed 18, and the last row
% then read two elements past the end of the buffer.  Every dimension except
% the one being extended must now match, as numpy requires ("all the input
% array dimensions except for the concatenation axis must match exactly"), and
% a mismatch aborts naming both shapes.  That error is not exercised here.
%
% Note the two spellings do NOT coincide for rank 1: `row || row` is a flat
% 10-element vector, not a 2x5 matrix, exactly as np.concatenate on two 1-D
% arrays gives a 1-D result.  Building a matrix by appending rows therefore has
% to start from a rank-2 seed (a 1xN gather), which is what `grown` does -- the
% ordinary accumulate-rows-in-a-loop pattern.

define Main

type Ints = array_dv [integer];

function Row (P, N : integer returns Ints)
   for K in 1, N returns array_dv of P * 10 + K end for
end function

function Main (N : integer
              returns
               Ints,      % 3x5 || one row      -> 4x5
               Ints,      % 3x5 || 2x5 stack    -> 5x5
               Ints,      % rows appended in a loop from a 1xN seed -> 4x5
               Ints,      % rank1 || rank1      -> flat 5
               Ints)      % 3x5 || empty        -> 3x5 unchanged
   let
      M   := for P in 1, 3 returns array_dv of Row(P, N) end for;
      blk := for P in 4, 5 returns array_dv of Row(P, N) end for;

      % the accumulate-rows pattern: seed is a 1xN matrix, not a bare row
      seed  := for P in 1, 1 returns array_dv of Row(P, N) end for;
      grown := for initial
                  R := 1;
                  Acc := seed;
               while R < 4 repeat
                  R := old R + 1;
                  Acc := old Acc || Row(old R + 1, N);
               returns value of Acc
               end for;

      empty := for K in 1, 0 returns array_dv of K end for;
   in
      M || Row(4, N),
      M || blk,
      grown,
      Row(1, N) || Row(2, N),
      M || empty
   end let
end function
