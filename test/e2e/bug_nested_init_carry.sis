% !!! NOT REGISTERED -- THIS IS A BUG REPRO.  It compiles, and the emitted C is
% SILENTLY WRONG.  See bug_init_carry_seed_scramble in memory.
%
% Scrambled INIT -> LoopB carry seeding.  The inner loop's carries are seeded
% from the WRONG INIT boundary outputs -- here `i` is seeded from `w4` and `sA`
% from `w5`, a contiguous window starting four slots too far.
%
% TRIGGER: NAME SHADOWING between the two for-initial scopes.  ONE shared name
% is enough -- this file uses eight only because that is how it was first found.
% Reduced further:
%
%   outer `initial` has w, inner `initial` has w   ->  OLD_I seeded from W  (bad)
%   outer `initial` has w, inner `initial` has v   ->  OLD_I seeded from OLD_I
%
% identical loops, the identifier is the ONLY difference.  Shadowing elsewhere
% (let scopes, params, a single loop) is fine; it is specifically a name shared
% between an enclosing and a nested for-initial's `initial` clause.  The count
% of shadowed names only shifts WHICH wrong slot is taken -- some counts land on
% the right one by accident, which is part of why this went unseen.
%
%     shadowed names  1 -> i seeded from w0
%                     2 -> i seeded from i     (CORRECT, BY ACCIDENT)
%                     4 -> i seeded from w0
%                     8 -> i seeded from w4    (this file)
%                    12 -> i seeded from w6
%
% The accidental hit at 2 is part of why it survived; the other part is that
% nothing in the corpus nested two for-initials sharing accumulator names until
% ssphot's tracking loop, which declares wrr/nrr/nsplt/... in BOTH scopes
% exactly as reproduced here.  That shadowing is in the original source, not an
% artefact of the port.
%
% ssphot_track_dv fails to BUILD because its shuffled types disagree.  Here they
% agree, so it builds and runs and is quietly incorrect -- the worse form.  Check
% wiring by NAME (each v_LoopB_*_X from v_INIT_*_X), never by "it compiled".

define Main
function Main (returns double, integer)
   let
      r0, r1, o0, o1, o2, o3, o4, o5, o6, o7 :=
      for initial
         s0 := 0.5d0;
         cnt := 0;
         w0 := 0.0d0;
         w1 := 0.0d0;
         w2 := 0.0d0;
         w3 := 0.0d0;
         w4 := 0.0d0;
         w5 := 0.0d0;
         w6 := 0.0d0;
         w7 := 0.0d0;
      while cnt < 2
      repeat
         s0, cnt, w0, w1, w2, w3, w4, w5, w6, w7 :=
            for initial
               i  := 1;
               sA := old s0;
            w0 := 0.0d0;
            w1 := 0.0d0;
            w2 := 0.0d0;
            w3 := 0.0d0;
            w4 := 0.0d0;
            w5 := 0.0d0;
            w6 := 0.0d0;
            w7 := 0.0d0;
            while i <= 2
            repeat
               sA := old sA * 2.0d0;
            w0 := old sA + 0.0d0;
            w1 := old sA + 1.0d0;
            w2 := old sA + 2.0d0;
            w3 := old sA + 3.0d0;
            w4 := old sA + 4.0d0;
            w5 := old sA + 5.0d0;
            w6 := old sA + 6.0d0;
            w7 := old sA + 7.0d0;
               i  := old i + 1
            returns
               value of sA
               value of sum i
            value of sum w0
            value of sum w1
            value of sum w2
            value of sum w3
            value of sum w4
            value of sum w5
            value of sum w6
            value of sum w7
            end for
      returns
         value of s0
         value of sum cnt
         value of sum w0
         value of sum w1
         value of sum w2
         value of sum w3
         value of sum w4
         value of sum w5
         value of sum w6
         value of sum w7
      end for
   in r0, r1 end let
end function
