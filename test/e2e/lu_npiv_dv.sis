% Origin: test/unit/lu.npiv.sis
% Port Note: Gauss-Jordan elimination without pivoting. Converted 2D ragged array (TwoD = array[array[double]])
% to flat rank-2 rank-polymorphic array_dv[double].
%
define Main

type OneD = array_dv[double];
type TwoD = array_dv[double];

function Reduce(pivot, n : integer; A : TwoD; B : OneD returns TwoD, OneD)
    let
        rA := for i in 1, n cross j in 1, n
                mult := A[i, pivot] / A[pivot, pivot];
                val := if i = pivot then
                         A[i, j] / A[pivot, pivot]
                       else
                         A[i, j] - mult * A[pivot, j]
                       end if;
              returns array_dv of val
              end for;
        rB := for i in 1, n
                mult := A[i, pivot] / A[pivot, pivot];
                val := if i = pivot then
                         B[i] / A[pivot, pivot]
                       else
                         B[i] - mult * B[pivot]
                       end if;
              returns array_dv of val
              end for;
    in
        rA, rB
    end let
end function

function Main(n : integer; Ain : TwoD; Bin : OneD returns OneD)
    for initial
        i := 0;
        A, B := Ain, Bin;
    while i < n repeat
        i := old i + 1;
        A, B := Reduce(i, n, old A, old B);
    returns value of B
    end for
end function
