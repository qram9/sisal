% Origin: test/unit/test_forall_simple.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
Define Main_CPU

type RealArray = array_dv[real];

function Main_CPU(N : integer returns RealArray)
  for i in 1, N
    X := real(i)
  returns array_dv of -X
  end for
end function
