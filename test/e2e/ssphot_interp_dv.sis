% Origin: test/unit/ssphot.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% SSPHOT_INTERP -- the opacity table lookup, layer 3 of the ssphot port.
%
% Given a material's temperature and density, bracket both in the tabulated
% grids and interpolate the 13 energy-group opacities out of a RANK-4 table
% x[density, temperature, energy, material].  The table stores LOGS, so the
% interpolation is linear in log space and the result is exponentiated -- which
% is why the two ratios are applied to xt/xt1 before `exp`, not after.
%
% THE BRACKET SEARCH is the interesting part and is preserved exactly:
%
%     itmax, itmin := for temp in <row> at i
%                        ubound := (matl.tmp <= temp);
%                     returns value of least    i unless (~ ubound)
%                             value of greatest i unless ubound
%                     end for;
%
% Two masked reductions over one scatter, with complementary masks: `least i
% unless (~ubound)` is the smallest index at or above the target, `greatest i
% unless ubound` the largest strictly below.  They are a bracket, and reading
% the double negative correctly matters -- `unless (~p)` is `when p`.
%
% The scatter source here is an inline EXPRESSION -- `for temp in t[ityp, ..] at
% i`, exactly as the original writes it.  That used to emit C++ referencing an
% undeclared generator relay temp (the boundary port was assigned but never
% declared, since neither decl pass covers an anonymous generator port).  A
% scatter over a plain NAME was always fine, because it resolves straight to the
% parent variable and needs no relay at all.  Fixed in relay_copyins, so the
% faithful spelling is what this file uses; xfa_scatter_expr_dv pins it.
%
% ARRAY MAPPING: `aaaareal = array_dv[array_dv[array_dv[array_dv[double_real]]]]` becomes a
% FLAT rank-4 array_dv, indexed x[id, it, ie, mtl].  `aareal` -> flat rank 2,
% `areal` -> rank 1.  Nested dopes are malformed and the C lowering is
% array_dv-only.
%
% Expected values are an exact C mirror in the harness.

define Main

type materialrec = record [ mtl : integer; atrat, dns, tmp : double;
                            matb, mate : integer ];
type Doubles = array_dv [double];    % rank 1, 2 or 4 depending on use
type Ints    = array_dv [integer];

% bracket `target` in a monotonically increasing grid row.  Kept only so Main
% can report the indices; Interp itself scatters inline, as the original does.
function Bracket (Row : Doubles; target : double returns integer, integer)
   for temp in Row at i
      ubound := (target <= temp);
   returns
      value of least    i unless (~ ubound)
      value of greatest i unless ubound
   end for
end function

function Interp (matl : materialrec; x : Doubles; t : Doubles; d : Doubles
                 returns Doubles)
   let
      e := 2.7182817459106445d0;
      % materials 2 and 4 index the second temperature grid
      ityp := if (matl.mtl = 2) | (matl.mtl = 4) then 2 else 1 end if;

      % the original's spelling: scatter straight over the grid row
      itmax, itmin := for temp in t[ityp, ..] at i
                         ubound := (matl.tmp <= temp);
                      returns
                         value of least    i unless (~ ubound)
                         value of greatest i unless ubound
                      end for;

      tmin := t[ityp, itmin];
      tmax := t[ityp, itmax];
      trat := (matl.tmp - tmin) / (tmax - tmin);

      idmax, idmin := for dns in d at i
                         ubound := (matl.dns <= dns);
                      returns
                         value of least    i unless (~ ubound)
                         value of greatest i unless ubound
                      end for;
      dmin := d[idmin];
      dmax := d[idmax];
      drat := (matl.dns - dmin) / (dmax - dmin)
   in
      for ie in 1, 13
         % interpolate in density at each bracketing temperature ...
         xt  := x[idmin, itmax, ie, matl.mtl] +
                (x[idmax, itmax, ie, matl.mtl] - x[idmin, itmax, ie, matl.mtl]) * drat;
         xt1 := x[idmin, itmin, ie, matl.mtl] +
                (x[idmax, itmin, ie, matl.mtl] - x[idmin, itmin, ie, matl.mtl]) * drat;
         % ... then in temperature, still in log space, and exponentiate
         opcv := exp(e, xt1 + (xt - xt1) * trat)
      returns array_dv of opcv
      end for
   end let
end function

function Main (mtl : integer; tmp, dns : double
              returns
               Doubles,   % the 13 interpolated opacities
               integer,   % itmin
               integer,   % itmax
               integer,   % idmin
               integer,   % idmax
               Ints)      % the table's shape, to pin that rank 4 survived
   let
      ND := 3;  NT := 4;  NE := 13;  NM := 4;

      % a synthetic but non-degenerate table: log-opacity varies in every axis
      x := for id in 1, ND returns array_dv of
              for it in 1, NT returns array_dv of
                 for ie in 1, NE returns array_dv of
                    for im in 1, NM returns array_dv of
                       double_real(id) * 0.5d0 + double_real(it) * 0.25d0
                       + double_real(ie) * 0.125d0 + double_real(im) * 0.0625d0
                    end for end for end for end for;

      % two temperature grids (materials 2 and 4 use the second), one density grid
      t := for k in 1, 2 returns array_dv of
              for j in 1, NT returns array_dv of
                 double_real(j) * 100.0d0 * double_real(k)
              end for end for;
      d := for j in 1, ND returns array_dv of double_real(j) * 2.0d0 end for;

      matl := record materialrec [ mtl : mtl; atrat : 1.0d0; dns : dns;
                                   tmp : tmp; matb : 1; mate : 1 ];

      ityp := if (mtl = 2) | (mtl = 4) then 2 else 1 end if;
      TRow := t[ityp, ..];
      itmax, itmin := Bracket(TRow, tmp);
      idmax, idmin := Bracket(d, dns);

      op := Interp(matl, x, t, d)
   in
      op, itmin, itmax, idmin, idmax,
      array_dv Ints [1: array_size(x), ND, NT, NE, NM]
   end let
end function
