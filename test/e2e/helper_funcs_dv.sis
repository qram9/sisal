% Origin: test/unit/helper_funcs.sis
% Port Note: Evaluates composition of top-level helper functions.
%
% Helper Functions & Function Delegation — DV Variant.
% Evaluates Increase(n) * IncreaseX(m) using top-level helper functions.
%
define Main, Increase, IncreaseX

function Increase(x : integer returns integer)
  x + 1
end function

function IncreaseX(x : integer returns integer)
  Increase(x) * 2
end function

function Main( n, m : integer returns integer )
  Increase(n) * IncreaseX(m)
end function
