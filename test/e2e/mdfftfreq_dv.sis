% MdFFTFreq -- the multi-factor FFT driver, from test/unit/MdFFTFreq.sis.  This
% is the top of the frequency-direction stack: it factors the transform across
% ifax[1..nfax] and drives PassFreq once per factor.  With the three butterfly
% kernels and PassFreq already promoted, inlining them here (e2e files are
% self-contained) puts the WHOLE stack under one end-to-end check rather than
% testing the pieces separately.
%
% What it adds over passfreq_dv:
%
%   * PING-PONG double buffering through a for-initial carrying TWO arrays and
%     an integer state -- `next` alternates 40/50 and selects which of x/work is
%     the source and which the destination on each factor.  A carry mis-wired
%     between the two buffers still produces an array of the right size.
%   * a multi-value IF returning (integer, array_dv, array_dv), taken inside the
%     loop body, so the array carries pass through a conditional every factor.
%   * the parity pre-step: when nfax is odd the first pass writes into x,
%     otherwise into work, so the ping-pong ends on the right buffer.
%   * `||` catenation of a truncated prefix with array_fill zeros to build the
%     final spectrum.
%
% ifax must be a real factorisation of n (radices 2, 3 and 4 only, matching the
% kernels), and la is divided down by each factor in turn.
%
% Checked against a NAIVE DFT rather than a snapshot: the per-pass groups check
% each pass against a transcription of that pass, so only composing them can
% show the passes actually compose into a Fourier transform.
%
% NOTE the fills are `array_dv_fill`, not `array_fill`.  Those are two distinct
% intrinsics -- array_fill builds a PLAIN array (AFILL), array_dv_fill builds a
% dope vector (DVAFILL) -- and mixing the two is what `||` refuses, since it
% requires both operands to be the same array flavour.  Using array_fill here
% gives `Type Mismatch: Expected array_dv[REAL], but found array[REAL]`, behind
% a misleading "Unexpected end of input" reported first.

DEFINE Main

type ArrInt1 = array_dv[integer];
type ArrReal1 = array_dv[real];

function IFACTm_2ETC(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1 
		    RETURNS ArrReal1)
FOR INITIAL
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia, ja, c := 
  IF old k = 0
  THEN 	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jb := old ja1 + jink;
	c1 := old c1[old ja1 : a[old ia1] + a[ib]; jb : a[old ia1]-a[ib]] 

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m 
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	kb := old k * 2;
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jbxx := old l - old ja1;
	tempr := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	c1 := old c1[old ja1 : a[old ia1] + tempr;
		   jbxx : a[old ia1] - tempr; 
		   old ja1 + 1 : a[old ia1 + 1] + tempi; 
		   jbxx + 1 : tempi - a[old ia1 + 1]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	c1 := old c1[old ja1 : a[old ia1]; old ja1 + 1 : - a[ib]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

END IF;

RETURNS VALUE of c
END FOR
end function

function IFACTm_3(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1
		    RETURNS ArrReal1)
FOR INITIAL
sin60 := 0.866025403784437;
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia,  ja,  c := 
  IF old k = 0
  THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	a1 := a[ib] + a[ic];
	a2 := a[old ia1] - 0.5 * a1;
	a3 := sin60 * (a[ic] - a[ib]);
	c1 := old c1[old ja1 : a[old ia1] + a1; jb : a2; jb + 1 : a3];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	kb := old k * 2;
	kc := kb * 2;
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	jcxx := old l - old ja1;
	tempr1 := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi1 := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	tempr2 := a[ic] * trigs[kc + 1] - a[ic + 1] * trigs[kc + 2];
	tempi2 := a[ic] * trigs[kc + 2] + a[ic + 1] * trigs[kc + 1];
	a1 := tempr1 + tempr2;
	b1 := tempi1 + tempi2;
	a2 := a[old ia1] - 0.5 * a1;
	b2 := a[old ia1 + 1] - 0.5 * b1;
	a3 := sin60 * (tempr2 - tempr1);
	b3 := sin60 * (tempi2 - tempi1);
	c1 := old c1[old ja1:a[old ia1] + a1; jb:a2 - b3; jcxx:a2 + b3; 
	   old ja1 + 1:a[old ia1 + 1] + b1; jb + 1:b2 + a3; jcxx + 1:a3 - b2]; 

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	a1 := a[ib] - a[ic];
	c1 := old c1[old ja1 : a[old ia1] + 0.5 * a1; jb : a[old ia1] - a1; 
		   old ja1 + 1 : -sin60 * (a[ib] + a[ic])];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR
END IF;

RETURNS VALUE of c
END FOR
end function

function IFACTm_4(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1 
	    	  RETURNS ArrReal1)
FOR INITIAL
sin45 := 0.7071067812;
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia,  ja,  c := 
  IF old k = 0
  THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	jc := jb + jink;
	a1 := a[old ia1] + a[ic];
	a2 := a[ib] + a[id];
	a3 := a[old ia1] - a[ic];
	a4 := a[id] - a[ib];
	c1 := old c1[old ja1 : a1 + a2; jb : a3; jc : a1 - a2; jb + 1 : a4]

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m 
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	jdxx := old l - old ja1;
	jcxx := jdxx + jink;
	kb := old k * 2;
	kc := kb * 2;
	kd := kc + kb;
	tempr1 := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi1 := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	tempr2 := a[ic] * trigs[kc + 1] - a[ic + 1] * trigs[kc + 2];
	tempi2 := a[ic] * trigs[kc + 2] + a[ic + 1] * trigs[kc + 1];
	tempr3 := a[id] * trigs[kd + 1] - a[id + 1] * trigs[kd + 2];
	tempi3 := a[id] * trigs[kd + 2] + a[id + 1] * trigs[kd + 1];
	a0 := a[old ia1] + tempr2;
	a1 := tempr1 + tempr3;
	a2 := a[old ia1] - tempr2;
	a3 := tempr1 - tempr3;
	b0 := a[old ia1 + 1] + tempi2;
	b1 := tempi1 + tempi3;
	b2 := a[old ia1 + 1] - tempi2;
	b3 := tempi1 - tempi3;
	c1 := old c1[old ja1 : a0 + a1; jb : a2 + b3; 
			jcxx : a0 - a1; jdxx : a2 - b3;
	   	     old ja1 + 1 : b0 + b1; jb + 1 : b2 - a3; 
			 jcxx + 1 : b1 - b0; jdxx + 1 : - b2 - a3];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

  ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	a1 := sin45 * (a[ib] - a[id]);
	a2 := sin45 * (a[ib] + a[id]);
	c1 := old c1[old ja1 : a[old ia1] + a1; jb : a[old ia1] - a1;
		   old ja1 + 1 : - a[ic] - a2; jb + 1 : a[ic] - a2];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

  END IF;

RETURNS VALUE of c
END FOR
end function

function PassFreq(inc1, inc2, n, ifac, la : integer; 
		    a, c, trigs : ArrReal1
		    RETURNS ArrReal1) % c
LET
m := n / ifac;
jink := inc2 * m;
iink := inc1 * la;
jump := (ifac - 1) * iink;
igo := ifac - 1;
c_return := 	
    IF igo=2 
	THEN IFACTm_3(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
    ELSEIF igo=3 
	THEN IFACTm_4(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
							
    ELSE IFACTm_2ETC(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
    END IF;

IN c_return
end LET
end function

function Main( nlev, nwave, nfax, n : integer;
		    ifax : ArrInt1; trigs, grid : ArrReal1
		    RETURNS ArrReal1)   
LET
la1    := n / ifax[1];
x_0    := array_dv_fill(1,n*2+2,0.0);
work_0 := array_dv_fill(1,n*2+2,0.0);
    x  :=    IF nfax <= 1 
	    THEN PassFreq(1, 2, n, ifax[1], la1, grid, x_0, trigs) 

	    ELSE 	
	    LET 
	    next1, x1, work1 :=
		IF MOD(nfax, 2) = 1 
		THEN 40,
		     PassFreq(1, 2, n, ifax[1], la1, grid, x_0, trigs),
		     work_0
		ELSE 50,
		     x_0,
		     PassFreq(1, 2, n, ifax[1], la1, grid, work_0, trigs)
		END IF;

	    x :=    FOR INITIAL
		    loop := 2;
		    la := la1;
		    next := next1;
		    x := x1;
		    work := work1;

		    WHILE loop <= nfax REPEAT
		    loop := old loop + 1;
		    la := old la / ifax[old loop];
		    next, x, work := 
			IF old next = 50
			THEN 40,
			     PassFreq(2, 2, n, ifax[old loop], la, 
					old work, old x, trigs),
			     old work
			ELSE 50,
			     old x,
			     PassFreq(2, 2, n, ifax[old loop], la, 
					old x, old work, trigs)
			END IF;

		    RETURNS VALUE of x
		    END FOR;

	    IN x
	    END LET

	    END IF;

    fourier :=  FOR truncated_index IN 1, nwave * 2
		RETURNS array_dv of x[truncated_index]
		END FOR
		|| array_dv_fill(nwave * 2 + 1, n, 0.0)

IN fourier	% Only one layer is built and returned
END LET
END FUNCTION
