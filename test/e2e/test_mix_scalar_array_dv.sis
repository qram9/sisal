% Origin: test/unit/test_mix_scalar_array.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main

type dvi = array_dv[integer]

function Main(flag: boolean returns integer, dvi, double_real)
    if flag then
        42, 
        array_dv dvi [1: 1, 2, 3], 
        3.14
    else
        0, 
        array_dv dvi [1: 0], 
        0.0
    end if
end function
