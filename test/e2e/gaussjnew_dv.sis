% gaussjnew -- Gauss-Jordan elimination with full row pivoting, from
% test/unit/gaussjnew.sis.  First of the Gauss/LU cluster, and the file that
% establishes how that whole cluster gets ported.
%
% THE RANK-2 REWRITE.  The original is
%     type Oned = array[double];
%     type Twod = array[Oned];        % array OF arrays
% and the point is that RANK IS A RUNTIME PROPERTY: OneD and TwoD are BOTH
% `array_dv[double]` and differ only in the dope.  Elements are A[i,j]; a row is
% A[i,..].
%
% Building rank 2 by GATHERING ROWS is legal and is what the original already
% does -- a nested `for ... returns array_dv of (for ... returns array_dv of ...)`
% yields a rank-2 array_dv (dims (n,n), row-major), NOT an array of arrays.  That
% holds when the row is bound first and gathered by name, which is the original's
% shape:
%     Arow := if ... then for x in Ain[i,..] returns array_dv of ... end for
%             else ... end if
%     ... returns array_dv of Arow
% So `Compute` is the original, unchanged apart from spelling.  The row-valued
% pivot swap `A[Icol: A[Irow,..]; Irow: A[Icol,..]]` is likewise kept verbatim
% and verified to swap rows correctly.
%
% ONE genuine deviation: `for row in A at i` -- scattering over the ROWS of a
% rank-2 -- is not supported ("Array type expected when constructing scatter
% node"), so GetPivot's outer loop is `for i in 1, n` with `row := A[i,..]`.
% Everything else about it, including the in-loop `value of greatest max` and
% the `least i when x = max` tie-break, is as written.
%
% THE REFERENCE IS THE RESIDUAL, max|Ax - b|, not a transcription of
% Gauss-Jordan.  Re-implementing the algorithm in the harness would agree with
% any shared misunderstanding of it; the residual only checks that the returned
% x actually solves the system, which is the property that matters and is
% independent of how it was obtained.  One such reference serves the whole
% Gauss/LU cluster.
%
% The third case has a ZERO on the diagonal, so it is unsolvable without the
% pivot swap -- it fails outright if GetPivot or the swap is wrong, rather than
% degrading quietly.

define Main

type Onei = array_dv[integer];
type OneD = array_dv[double];
type TwoD = array_dv[double];      % RANK 2 at runtime; rank is never in the type

function GetPivot(n: integer; A: TwoD; PIVR: Onei returns integer, integer)
   let
      cols, maxs, max :=
          for i in 1, n
              row := A[i,..];
              col, max := if PIVR[i] = 0 then
                             for initial
                                 j   := 1;
                                 col := 1;
                                 max := abs(row[1])
                             while j < n repeat
                                 j   := old j + 1;
                                 col, max :=
                                   if abs(row[j]) > old max then
                                      j, abs(row[j])
                                   else
                                      old col, old max
                                   end if
                             returns value of col
                                     value of max
                             end for
                          else
                             0, 0.0d0
                          end if
          returns array_dv of col
                  array_dv of max
                  value of greatest max
          end for;
      row := for x in maxs at i
             returns value of least i when x = max
             end for
   in
      cols[row], row
   end let
end function

function Compute(n, pvtrow: integer; Ain: TwoD; Bin: OneD returns TwoD, OneD)
   for i in 1, n
       pvtele     := Ain[pvtrow, pvtrow];
       multipler  := Ain[i, pvtrow] / pvtele;
       Arow, Bele := if i = pvtrow then
                        for x in Ain[i,..]
                        returns array_dv of x / pvtele
                        end for,
                        Bin[i] / pvtele
                     else
                        for x in Ain[i,..] at j
                        returns array_dv of x - multipler * Ain[pvtrow, j]
                        end for,
                        Bin[i] - multipler * Bin[pvtrow]
                     end if
   returns array_dv of Arow
           array_dv of Bele
   end for
end function

function Main(n: integer; Ain: TwoD; Bin: OneD returns OneD)
   for initial
       I    := 0;
       A, B := Ain, Bin;
       PIVR := array_dv_fill(1,n,0)
   while I < n repeat
       I := old I + 1;
       Icol, Irow := GetPivot(n, old A, old PIVR);
       A1, B1 := if ( Icol ~= Irow ) then
                     (old A)[Icol: (old A)[Irow,..]; Irow: (old A)[Icol,..]],
                     (old B)[Icol: (old B)[Irow];    Irow: (old B)[Icol]]
                 else
                     old A, old B
                 end if;
       PIVR := old PIVR[Icol: 1];
       A, B := Compute(n, Icol, A1, B1)
   returns value of B
   end for
end function
