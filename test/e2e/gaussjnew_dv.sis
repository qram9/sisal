% gaussjnew -- Gauss-Jordan elimination with full row pivoting, from
% test/unit/gaussjnew.sis.  First of the Gauss/LU cluster, and the file that
% establishes how that whole cluster gets ported.
%
% THE RANK-2 REWRITE.  The original is
%     type Oned = array[double];
%     type Twod = array[Oned];        % array OF arrays
% which the mechanical array->array_dv rewrite turns into the illegal
% array_dv[array_dv[double]].  The real form is that RANK IS A RUNTIME PROPERTY:
% TwoD and OneD are BOTH `array_dv[double]` and differ only in the dope.
% Elements are A[i,j]; a row would be A[i,..].
%
% Two constructs had to change shape, not just spelling:
%
%   * `for row in A at i ... returns array of Arow` builds a rank-2 by gathering
%     ROWS, i.e. exactly the nested array_dv the model forbids.  Replaced by a
%     CROSS forall over (i,j) returning elements, which yields rank 2 directly.
%   * the pivot row swap `old A[Icol: old A[Irow]; Irow: old A[Icol]]` replaces
%     whole ROWS of a rank-2.  Replaced by a cross forall that selects from the
%     swapped index, so no row-valued replace is needed.
%
% The algorithm is otherwise untouched: same pivot search (largest |a| over rows
% not yet pivoted, ties to the LEAST row index), same swap, same elimination.
%
% THE REFERENCE IS THE RESIDUAL, max|Ax - b|, not a transcription of
% Gauss-Jordan.  Re-implementing the algorithm in the harness would agree with
% any shared misunderstanding of it; the residual only checks that the returned
% x actually solves the system, which is the property that matters and is
% independent of how it was obtained.  One such reference serves the whole
% Gauss/LU cluster.
%
% The third case has a ZERO on the diagonal, so it is unsolvable without the
% pivot swap -- it fails outright if GetPivot or the swap is wrong, rather than
% degrading quietly.

define Main

type Onei = array_dv[integer];
type OneD = array_dv[double];
type TwoD = array_dv[double];      % RANK 2 at runtime; rank is never in the type

function GetPivot(n: integer; A: TwoD; PIVR: Onei returns integer, integer)
   let
      cols, maxs :=
          for i in 1, n
              col, max := if PIVR[i] = 0 then
                             for initial
                                 j   := 1;
                                 col := 1;
                                 max := abs(A[i,1])
                             while j < n repeat
                                 j   := old j + 1;
                                 col, max :=
                                   if abs(A[i,j]) > old max then
                                      j, abs(A[i,j])
                                   else
                                      old col, old max
                                   end if
                             returns value of col
                                     value of max
                             end for
                          else
                             0, 0.0d0
                          end if
          returns array_dv of col
                  array_dv of max
          end for;
      max := for i in 1, n returns value of greatest maxs[i] end for;
      row := for i in 1, n returns value of least i when maxs[i] = max end for
   in
      cols[row], row
   end let
end function

function Compute(n, pvtrow: integer; Ain: TwoD; Bin: OneD returns TwoD, OneD)
   let
      pvtele := Ain[pvtrow, pvtrow];
      Aout := for i in 1, n cross j in 1, n
                 m := Ain[i, pvtrow] / pvtele
              returns array_dv of if i = pvtrow then
                                     Ain[i,j] / pvtele
                                  else
                                     Ain[i,j] - m * Ain[pvtrow,j]
                                  end if
              end for;
      Bout := for i in 1, n
                 m := Ain[i, pvtrow] / pvtele
              returns array_dv of if i = pvtrow then
                                     Bin[i] / pvtele
                                  else
                                     Bin[i] - m * Bin[pvtrow]
                                  end if
              end for
   in
      Aout, Bout
   end let
end function

function Main(n: integer; Ain: TwoD; Bin: OneD returns OneD)
   for initial
       I    := 0;
       A, B := Ain, Bin;
       PIVR := array_dv_fill(1,n,0)
   while I < n repeat
       I := old I + 1;
       Icol, Irow := GetPivot(n, old A, old PIVR);
       % row swap done as a cross forall rather than a row-replace: a row of a
       % rank-2 array_dv is A[i,..], and replacing one would need the nested form
       A1 := if Icol ~= Irow then
                for i in 1, n cross j in 1, n
                returns array_dv of if i = Icol then (old A)[Irow, j]
                                    elseif i = Irow then (old A)[Icol, j]
                                    else (old A)[i, j]
                                    end if
                end for
             else old A
             end if;
       B1 := if Icol ~= Irow then
                for i in 1, n
                returns array_dv of if i = Icol then (old B)[Irow]
                                    elseif i = Irow then (old B)[Icol]
                                    else (old B)[i]
                                    end if
                end for
             else old B
             end if;
       PIVR := old PIVR[Icol: 1];
       A, B := Compute(n, Icol, A1, B1)
   returns value of B
   end for
end function
