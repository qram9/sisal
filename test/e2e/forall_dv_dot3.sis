% Origin: test/unit/test_forall_dot.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% x in A DOT y in B DOT z in C — zip three arrays.
% Element vars (x,y,z) must not case-collide with the arrays (A,B,C): Sisal is
% case-insensitive, so `for a in A` self-shadows A and miscompiles.
function Main( A: array_dv[integer]; B: array_dv[integer]; C: array_dv[integer] returns array_dv[integer] )
  for x in A DOT y in B DOT z in C
  returns array_dv of x + y + z
  end for
end function
