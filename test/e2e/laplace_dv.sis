% Origin: test/unit/laplace.sis
% Port Note: 2D Laplace equation solver. Converted 2D ragged array (Grid = array[array[double_real]])
% to flat rank-2 rank-polymorphic array_dv[double_real].
%
define Main

type Grid = array_dv[double_real];

function Phi( A, B : integer returns double_real )
    let
        X := double_real( A );
        Y := double_real( B );
    in
        X * Y
    end let
end function

function BuildGrid( Rows, Columns : integer returns Grid )
    for I in 0, Rows + 1 cross J in 0, Columns + 1
        Val := if I = 0 then
                 Phi(1, J + 1)
               elseif I = Rows + 1 then
                 Phi(Rows + 2, J + 1)
               elseif J = 0 then
                 Phi(I + 1, 1)
               elseif J = Columns + 1 then
                 Phi(I + 1, Columns + 2)
               else
                 0.0D0
               end if;
    returns array_dv of Val
    end for
end function

function Compute( G : Grid; I, J : integer returns double_real )
    (G[I, J - 1] + G[I, J + 1] + G[I + 1, J] + G[I - 1, J]) / 4.0D0
end function

function DoWork( G : Grid; Rows, Columns : integer returns Grid )
    for I in 0, Rows + 1 cross J in 0, Columns + 1
        Val := if (I = 0 | I = Rows + 1 | J = 0 | J = Columns + 1) then
                 G[I, J]
               else
                 Compute(G, I, J)
               end if;
    returns array_dv of Val
    end for
end function

function Main( Num : integer; Rows, Columns : integer returns Grid )
    for initial
        Count := Num;
        NewG  := BuildGrid( Rows, Columns );
    while ( Count > 0 ) repeat
        Count := old Count - 1;
        NewG  := DoWork( old NewG, Rows, Columns ); 
    returns value of NewG
    end for
end function
