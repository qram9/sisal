% Origin: test/unit/test_mix_scalar_array.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main

function Main(N: integer returns array_dv[integer], array_dv[integer])
    for i in 1, N
    returns 
        array_dv of i
        array_dv of i * 10
    end for
end function
