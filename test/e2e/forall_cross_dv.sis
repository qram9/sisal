% Origin: test/unit/test_forall_cross.sis, test/unit/forall_dv_cross_dot.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% Element-scatter CROSS over dv values — outer product, flat rank-2.
% Regression pin: the forall's dot-conformance diamond used to zip the
% INDEPENDENT cross axes into one DV_CONFORM; different sizes (3 x 2)
% took the error arm and returned an empty array.  Conformance is a
% same-axis (dot) property only.
define main
function main(A, B: array_dv[integer] returns array_dv[integer])
    for x in A cross y in B
    returns array_dv of x * y
    end for
end function
