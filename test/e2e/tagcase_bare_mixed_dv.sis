% Origin: test/unit/tagcase_bare_mixed.sis
% Port Note: uses list pattern / union node representation for unavoidable ragged structures.
%
% Mixed bound/bare tagcase nesting — classification must be PER INSTANCE
% (the backend resolves each arm's own TAGCASE compound via parent_map and
% keys the port-0 payload protocol on that node's TAGCASE_BARE pragma):
% a bare tagcase inside a bound arm, and a bound tagcase (whose arm reads
% its payload) inside a bare arm.
define Main

type UN = union[ A: integer; B: real ]

function Mk( s: integer returns UN )
  if s = 1 then union UN[ A: 42 ] else union UN[ B: 3.14 ] end if
end function

function BareInBound( s: integer returns integer )
  tagcase p := Mk( s )
  tag A:
    tagcase Mk( p )
    tag A: 1
    tag B: 2
    end tagcase
  tag B: 3
  end tagcase
end function

function BoundInBare( s: integer returns integer )
  tagcase Mk( s )
  tag A:
    tagcase q := Mk( s + 1 )
    tag A: q
    tag B: 2
    end tagcase
  tag B: 3
  end tagcase
end function

function Main( s: integer returns integer, integer )
  BareInBound( s ), BoundInBare( s )
end function
