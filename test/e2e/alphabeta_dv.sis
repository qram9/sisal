% Origin: test/unit/alphabeta.sis
% Port Note: AlphaBeta array calculation stage of Job Shop scheduler ported to flat rank-2 array_dv[Element] and rank-1 array_dv[real].
%
define Main

type SRec = record [Start, Finish, Duration: real; Priority: integer];
type SRec_OneDim = array_dv [SRec];
type Element = record [Alpha, Beta: real; Priority: integer];
type AB_TwoDim = array_dv [Element];
type Real_OneDim = array_dv [real];

function AlphaBeta (Sorted : SRec_OneDim; Q : integer returns AB_TwoDim, Real_OneDim)
  for Elt in Sorted
     Last_Start := Elt.Finish - Elt.Duration;
     Del := (Last_Start - Elt.Start) / real(Q);
     Row := 
        for I in 1, Q+1
           Alpha := Elt.Start + (real(I-1) * Del);
           Beta := Alpha + Elt.Duration;
        returns
           array_dv of record Element [Alpha: Alpha; Beta: Beta; Priority: Elt.Priority]
        end for;
  returns
     array_dv of Row
     array_dv of Del
  end for
end function

function Main (Sorted : SRec_OneDim; Q : integer returns AB_TwoDim, Real_OneDim)
  AlphaBeta(Sorted, Q)
end function
