% Origin: test/unit/test_forall_dot.sis, test/unit/forall_dv_dot_cross.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% for x . y in A, B — zip (paired elements, same length).
% Element vars (x,y) must not case-collide with the arrays (A,B): Sisal is
% case-insensitive, so `for a in A` self-shadows A and miscompiles.
function Main( A: array_dv[integer]; B: array_dv[integer] returns array_dv[integer] )
  for x in A DOT y in B
  returns array_dv of x + y
  end for
end function
