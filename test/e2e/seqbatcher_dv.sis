% Origin: test/unit/seqbatcher.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% SEQBATCHER — DV variant (array -> array_dv; no other changes).
%
% NOTE: this program is NOT a correct sort.  Its exchange skeleton seeds the
% inner Q at 2^(T-1) and exits at `Q <= old P`, so the R-subpasses a full
% Batcher merge-exchange needs never run (all three of pbatcher/sbatcher/
% seqbatcher share the skeleton and mis-sort identically under every `old P`
% reading; simplebatcher_dv is the correct member of the family).  The e2e
% value of this test is COMPILER FIDELITY: the harness mirrors this exact
% dataflow in C and checks equality.  It pins:
%   - `old P` in a nested loop = the ENCLOSING loop's previous-iteration value
%     (read after P's redefinition in the outer body);
%   - a LoopA (repeat..until) OUTER loop around a LoopA inner loop around a
%     sequential LoopB swap chain (3-deep for-initial nest);
%   - CSwap's multi-entry replace A[I: A[J]; J: A[I]];
%   - the BITWISE_AND global resolving to the runtime intrinsic.
%
define Main

type aint = array_dv[ integer ]

global Bitwise_And( a,b:integer returns integer )

function CSwap( A:aint; I, J:integer returns aint )
if ( A[I] > A[J] ) then
    A[I:A[J];J:A[I]]
else
    A
end if
end function

function CeilingOfLog2( N: integer returns integer )
  for initial
    L := 0;
    TwoToTheL := 1
  while TwoToTheL < N repeat
    L := old L + 1;
    TwoToTheL := 2*old TwoToTheL
  returns value of L
  end for
end function % CeilingOfLog2

function Main( K: aint returns aint )
  let
    N    := array_size(K);
    TTM1 := exp(2, CeilingOfLog2( N ) - 1);
  in
    for initial
      P := TTM1;
      B := K;
    repeat
      P := old P/2;

      B :=
        for initial
	  Q := TTM1;
	  R := 0;
	  D := old P;
	  C := old B
	repeat
	  C :=
            for initial I := 0; AA := old C; 
	    while ( I + old D < N ) repeat
	      I  := old I + 1;
	      AA :=
		if ( Bitwise_And( old I, old P ) = old R ) then
		  CSwap( old AA, old I+1, old I+old D+1 )
		else
		  old AA
		end if;
	    returns value of AA
	    end for;
	  D := old Q - old P;
	  Q := old Q / 2;
	  R := old P
	until Q <= old P
	returns value of C
	end for
    until P <= 0
    returns value of B
    end for
  end let
end function % Main
