% Origin: test/unit/array_ex.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main
type aareal = array_dv[real]
function Main (returns aareal)
let rh : aareal := array_dv aareal[1:1.18,7.23,3.18,10.6] in
let ph : aareal := array_dv aareal[1:2.18,4.23,6.18,12.6] in
rh[1:rh[2];2:rh[3]] || ph
end let
end let
end function
