% Origin: test/unit/loop1.sis
% Port Note: adapted for rank-polymorphic e2e execution.
%
define Main

type IntArray = array_dv[integer]

function Main(A : IntArray; N, Steps : integer returns IntArray)
    for initial
        i := 1;
        CurrA := A
    while i <= Steps repeat
        i := old i + 1;
        NewA := for j in 1, N - 1
                    val := old CurrA[j] + old CurrA[j + 1]
                returns array_dv of val
                end for;
        CurrA := NewA
    returns value of CurrA
    end for
end function
