% PassFreq -- the FFT pass dispatcher, from test/unit/PassFreq.sis.  It derives
% the pass parameters from (n, ifac, la, inc1, inc2) and hands off to one of
% three butterfly kernels:
%
%     m := n / ifac;  jink := inc2 * m;  iink := inc1 * la;
%     jump := (ifac - 1) * iink;  igo := ifac - 1
%     igo = 2 -> IFACTm_3     (ifac 3)
%     igo = 3 -> IFACTm_4     (ifac 4)
%     else    -> IFACTm_2ETC  (ifac 2 and the general case)
%
% The unit original declares the three kernels as `global` and relies on
% separate compilation.  e2e files are SELF-CONTAINED -- %$include is
% cwd-relative and the harness compiles from elsewhere -- so the three kernels
% are INLINED here verbatim, the same convention angmom_dv.sis uses for the
% CpxFuncs helpers and tuple_destructure.sis for its two unit halves.
%
% This is what the three ifm_*_dv groups were promoted for: with the kernels
% present as real definitions, the dispatcher itself becomes testable.  The
% harness reference is correspondingly cheap -- the same dispatch over the three
% kernel references already validated against OSC 13.0.3 for those groups.
%
% What it adds beyond them: the parameter derivation (which the kernels receive
% ready-made in their own tests) and the three-way selection, so a wrong igo
% mapping or a wrong jump/iink/jink formula shows up here and nowhere else.

DEFINE Main

type ArrReal1 = array_dv[real]

function IFACTm_2ETC(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1 
		    RETURNS ArrReal1)
FOR INITIAL
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia, ja, c := 
  IF old k = 0
  THEN 	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jb := old ja1 + jink;
	c1 := old c1[old ja1 : a[old ia1] + a[ib]; jb : a[old ia1]-a[ib]] 

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m 
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	kb := old k * 2;
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jbxx := old l - old ja1;
	tempr := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	c1 := old c1[old ja1 : a[old ia1] + tempr;
		   jbxx : a[old ia1] - tempr; 
		   old ja1 + 1 : a[old ia1 + 1] + tempi; 
		   jbxx + 1 : tempi - a[old ia1 + 1]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	c1 := old c1[old ja1 : a[old ia1]; old ja1 + 1 : - a[ib]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

END IF;

RETURNS VALUE of c
END FOR
end function

function IFACTm_3(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1
		    RETURNS ArrReal1)
FOR INITIAL
sin60 := 0.866025403784437;
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia,  ja,  c := 
  IF old k = 0
  THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	a1 := a[ib] + a[ic];
	a2 := a[old ia1] - 0.5 * a1;
	a3 := sin60 * (a[ic] - a[ib]);
	c1 := old c1[old ja1 : a[old ia1] + a1; jb : a2; jb + 1 : a3];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	kb := old k * 2;
	kc := kb * 2;
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	jcxx := old l - old ja1;
	tempr1 := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi1 := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	tempr2 := a[ic] * trigs[kc + 1] - a[ic + 1] * trigs[kc + 2];
	tempi2 := a[ic] * trigs[kc + 2] + a[ic + 1] * trigs[kc + 1];
	a1 := tempr1 + tempr2;
	b1 := tempi1 + tempi2;
	a2 := a[old ia1] - 0.5 * a1;
	b2 := a[old ia1 + 1] - 0.5 * b1;
	a3 := sin60 * (tempr2 - tempr1);
	b3 := sin60 * (tempi2 - tempi1);
	c1 := old c1[old ja1:a[old ia1] + a1; jb:a2 - b3; jcxx:a2 + b3; 
	   old ja1 + 1:a[old ia1 + 1] + b1; jb + 1:b2 + a3; jcxx + 1:a3 - b2]; 

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	jb := old ja1 + jink;
	a1 := a[ib] - a[ic];
	c1 := old c1[old ja1 : a[old ia1] + 0.5 * a1; jb : a[old ia1] - a1; 
		   old ja1 + 1 : -sin60 * (a[ib] + a[ic])];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR
END IF;

RETURNS VALUE of c
END FOR
end function

function IFACTm_4(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1 
	    	  RETURNS ArrReal1)
FOR INITIAL
sin45 := 0.7071067812;
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia,  ja,  c := 
  IF old k = 0
  THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	jc := jb + jink;
	a1 := a[old ia1] + a[ic];
	a2 := a[ib] + a[id];
	a3 := a[old ia1] - a[ic];
	a4 := a[id] - a[ib];
	c1 := old c1[old ja1 : a1 + a2; jb : a3; jc : a1 - a2; jb + 1 : a4]

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m 
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	jdxx := old l - old ja1;
	jcxx := jdxx + jink;
	kb := old k * 2;
	kc := kb * 2;
	kd := kc + kb;
	tempr1 := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi1 := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	tempr2 := a[ic] * trigs[kc + 1] - a[ic + 1] * trigs[kc + 2];
	tempi2 := a[ic] * trigs[kc + 2] + a[ic + 1] * trigs[kc + 1];
	tempr3 := a[id] * trigs[kd + 1] - a[id + 1] * trigs[kd + 2];
	tempi3 := a[id] * trigs[kd + 2] + a[id + 1] * trigs[kd + 1];
	a0 := a[old ia1] + tempr2;
	a1 := tempr1 + tempr3;
	a2 := a[old ia1] - tempr2;
	a3 := tempr1 - tempr3;
	b0 := a[old ia1 + 1] + tempi2;
	b1 := tempi1 + tempi3;
	b2 := a[old ia1 + 1] - tempi2;
	b3 := tempi1 - tempi3;
	c1 := old c1[old ja1 : a0 + a1; jb : a2 + b3; 
			jcxx : a0 - a1; jdxx : a2 - b3;
	   	     old ja1 + 1 : b0 + b1; jb + 1 : b2 - a3; 
			 jcxx + 1 : b1 - b0; jdxx + 1 : - b2 - a3];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

  ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	ic := ib + iink;
	id := ic + iink;
	jb := old ja1 + jink;
	a1 := sin45 * (a[ib] - a[id]);
	a2 := sin45 * (a[ib] + a[id]);
	c1 := old c1[old ja1 : a[old ia1] + a1; jb : a[old ia1] - a1;
		   old ja1 + 1 : - a[ic] - a2; jb + 1 : a[ic] - a2];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

  END IF;

RETURNS VALUE of c
END FOR
end function

function Main(inc1, inc2, n, ifac, la : integer; 
		    a, c, trigs : ArrReal1
		    RETURNS ArrReal1) % c
LET
m := n / ifac;
jink := inc2 * m;
iink := inc1 * la;
jump := (ifac - 1) * iink;
igo := ifac - 1;
c_return := 	
    IF igo=2 
	THEN IFACTm_3(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
    ELSEIF igo=3 
	THEN IFACTm_4(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
							
    ELSE IFACTm_2ETC(m, la, iink, jink, jump, inc1, inc2, a, c, trigs)
    END IF;

IN c_return
end LET
end function
