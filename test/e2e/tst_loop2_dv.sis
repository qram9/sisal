% Origin: test/unit/tst_loop2.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% Hydro Fragment
% Parallel Algorithm

Define  Main

%type double = double_real;
type OneD   = array_dv[double];

function Main( Y:OneD returns double )
   for K in Y
       X := K+K
   returns VALUE OF sum X
   end for
end function

