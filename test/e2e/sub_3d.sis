% Origin: test/unit/subscript_slicing.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% 3-D round-trip: A[i,j,k]=i*100+j*10+k; read A[2,3,1] = 231
define main
function main(N: integer returns integer)
  let A := for i in 1,N cross j in 1,N cross k in 1,N
           returns array_dv of i*100 + j*10 + k end for
  in A[2,3,1] end let
end function
