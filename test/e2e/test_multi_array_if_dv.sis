% Origin: test/unit/test_multi_array_if.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main

type dvi = array_dv[integer]
type dvd = array_dv[double_real]

function Main(N: integer returns dvd, dvi)
    for i in 1, N
    returns 
        array_dv of if mod(i, 2) = 0 then double_real(i) * 1.5 else double_real(i) * 0.5 end if
        array_dv of i * i
    end for
end function
