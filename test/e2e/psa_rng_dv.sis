% PSA_RNG -- the random-number layer of psa.sis (Parallel Scheduler v1.0,
% 03/23/89: simulated annealing on the School TimeTable Problem).
%
% psa could not be compiled at all until the for-initial gather stopped
% requiring a derivable trip count: `rans` below is `while i < n`, but the
% scheduler proper has `while to = from` and `while ~found & (i < ...)`.  This
% is the first layer of that port.
%
% It is worth having on its own.  The generator is a 48-bit multiplicative
% congruential sequence carried in FOUR 12-bit limbs -- a bignum in base 4096
% built out of nothing but integer * / and mod -- so it pins exact integer
% semantics end to end.  Every value is reproducible: no clock, no OS entropy.
%
% THE ARRAY MAPPING.  `fourplex` is a 0-BASED rank-1 array_dv of 4 limbs, so
% the literals stay `array_dv fourplex [0: ...]` and a[0]..a[3] index as written.
% `Seed_Type = array [fourplex]` -- an array of those -- becomes a rank-2
% array_dv (n x 4), which is what `rans`'s `array_dv of seed` gather produces
% by stacking rank-1 rows.  A row comes back out by subscript, which
% rank-reduces: SS[i, ..] is the i-th 4-limb seed, still 0-based on its own
% axis.  The `, ..` is required -- SeedSet is statically `array_dv [integer]`,
% so a bare SS[i] is an INTEGER by the type system (rank is a runtime property),
% and it lowers to a scalar limb read.
% `bitarray` stays rank 1, 1-based, 48 long -- ranf_a_to_k reads k[1]..k[46].
%
% Expected values are OSC 13.0.3's (~/work/oldsisal), for n = 5, seed1 = 12345.
% Note the original does not compile under OSC as shipped: line 21 comments out
% `type double = double_real` while `ranf` returns `double`.  Our compiler
% accepts `double` as a built-in alias, so the source is otherwise unchanged.

define Main

type Ints     = array_dv [integer];
type fourplex = array_dv [integer];   % 4 limbs, 0-based
type bitarray = array_dv [integer];   % 48 bits, 1-based
type SeedSet  = array_dv [integer];   % rank 2 at runtime: n x 4

function ranf_odd (n : integer returns integer)
   if mod(n, 2) = 0 then 0 else 1 end if
end function

function ranf_even (n : integer returns integer)
   if mod(n, 2) = 0 then 1 else 0 end if
end function

% a * b where both are 4 12-bit limbs; the multiplication is done piecemeal
function ranf_mod_mult (a, b : fourplex returns fourplex)
   let
       j0 := a[0] * b[0];
       j1 := a[0] * b[1] + a[1] * b[0];
       j2 := a[0] * b[2] + a[1] * b[1] + a[2] * b[0];
       j3 := a[0] * b[3] + a[1] * b[2] + a[2] * b[1] + a[3] * b[0];
       k0 := j0;
       k1 := j1 + k0 / 4096;
       k2 := j2 + k1 / 4096;
       k3 := j3 + k2 / 4096
   in
       array_dv fourplex [0: mod(k0, 4096), mod(k1, 4096), mod(k2, 4096), mod(k3, 4096)]
   end let
end function

% floor((2**46) / nn) as 4 limbs; the divisor is made odd for statistical reasons
function ranf_k (n : integer returns fourplex)
   let
       nn := n + ranf_even(n);
       q3 := 1024 / nn;
       r3 := 1024 - (nn * q3);
       q2 := (r3 * 4096) / nn;
       r2 := (r3 * 4096) - (nn * q2);
       q1 := (r2 * 4096) / nn;
       r1 := (r2 * 4096) - (nn * q1);
       q0 := (r1 * 4096) / nn
   in
       array_dv fourplex [0: q0, q1, q2, q3]
   end let
end function

% binary representation of k, least significant bit first
function ranf_k_binary (k : fourplex returns bitarray)
   for i in 0, 3
   returns value of catenate
       for initial
           j   := 1;
           x   := k[i] / 2;
           bit := ranf_odd(k[i])
       while j < 12 repeat
           j   := old j + 1;
           x   := old x / 2;
           bit := ranf_odd(old x)
       returns array_dv of bit
       end for
   end for
end function

% a**k mod 2**48, by squaring: multiply in a_i whenever bit k[i] is set
function ranf_a_to_k (a : fourplex; k : bitarray returns fourplex)
   for initial
       i   := 0;
       a_i := a;
       a_k := array_dv fourplex [0: 1, 0, 0, 0]
   while i < 46 repeat
       i   := old i + 1;
       a_k := if k[i] = 0 then
                 old a_k
              else
                 ranf_mod_mult(old a_k, old a_i)
              end if;
       a_i := ranf_mod_mult(old a_i, old a_i)
   returns value of a_k
   end for
end function

% n seeds, one per segment of the wheel: seed(i) = seed(i-1) * a**k mod 2**48.
% The `array_dv of seed` gather stacks rank-1 rows into the rank-2 SeedSet.
function rans (n, seed1 : integer returns SeedSet)
   for initial
       i    := 1;
       seed := if seed1 = 0 then
                  array_dv fourplex [0: 3281, 4041, 595, 2376]
               else
                  array_dv fourplex [0: abs(seed1), 0, 0, 0]
               end if;
       a    := array_dv fourplex [0: 373, 3707, 1442, 647];
       a_k  := ranf_a_to_k(a, ranf_k_binary(ranf_k(n)))
   while i < n repeat
       i    := old i + 1;
       seed := ranf_mod_mult(old seed, a_k)
   returns array_dv of seed
   end for
end function

% the next random number and seed: the seed's bits shifted right 48 places
function ranf (seed : fourplex returns double, fourplex)
   double_real(seed[3]) / 4096.0d0 +
   double_real(seed[2]) / 16777216.0d0 +
   double_real(seed[1]) / 68719476736.0d0 +
   double_real(seed[0]) / 281474976710656.0d0,

   ranf_mod_mult(array_dv fourplex [0: 373, 3707, 1442, 647], seed)
end function

function Main (n, s1 : integer
              returns
               fourplex,   % ranf_k(n)
               bitarray,   % its 48-bit expansion
               fourplex,   % a**k mod 2**48
               SeedSet,    % the n seeds, rank 2 (n x 4)
               double,     % ranf of the first seed
               fourplex)   % and the seed that follows it
   let
      K     := ranf_k(n);
      KB    := ranf_k_binary(K);
      AK    := ranf_a_to_k(array_dv fourplex [0: 373, 3707, 1442, 647], KB);
      SS    := rans(n, s1);
      r, s2 := ranf( SS[1, ..] )
   in
      K, KB, AK, SS, r, s2
   end let
end function
