% Origin: test/unit/test_if_array.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main

type dvi = array_dv[integer]

function Main(flag: boolean returns dvi)
    if flag then
        array_dv dvi [1: 1, 2, 3]
    else
        array_dv dvi [1: 4, 5, 6]
    end if
end function
