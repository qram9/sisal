% Origin: test/unit/basic.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main
function main(n, m: integer returns array_dv[integer])
  for i in 1, n cross j in 1, m
    p := i * j
  returns array_dv of p
  end for
end function
