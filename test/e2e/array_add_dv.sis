% Origin: test/unit/mat2_ops.sis, test/unit/mat_ops.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
DEFINE MAIN

FUNCTION MAIN(A, B : array_dv[REAL] RETURNS array_dv[REAL])
  for i in 0, array_size(A)-1
    X := A[i] + B[i];
  returns array_dv of X
  end for
END FUNCTION
