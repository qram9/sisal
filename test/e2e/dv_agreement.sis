% Origin: test/unit/mat_ops.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main

type OneD = array_dv[integer];

% Test APL-style Leading Axis Agreement in forall loops.
% Multiple Array_dv generators trigger DV_CONFORM checks.
function main(A, B: OneD returns OneD)
  for i in A dot j in B
  returns array_dv of i + j
  end for
end function
