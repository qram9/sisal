% Origin: test/unit/bmk11a.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% BMK11A, part 1 of 3 -- the particle mover `parmve` and its boundary conditions.
%
% test/unit/bmk11a.sis is a particle-in-cell plasma benchmark: 2560 particles
% pushed through a 16x16 field grid.  1003 lines but only 7 functions, so it is
% landed in parts like unsplit -- this one covers BCND/BCNDUpdate1/BCNDUpdate2
% (boundary handling) and parmve (the electrostatic mover), which between them
% are the whole particle-push loop.
%
% THE ARRAY REWRITE is the smallest of any port so far: bmk11a's types are RANK
% 1 only (`array_dv[double]`, `array_dv[integer]`), with no array-of-array nesting
% anywhere, so the rewrite is purely `array` -> `array_dv`, `returns array_dv of`
% -> `returns array_dv of`.  `array_fill` is unchanged -- it already builds an
% array_dv.  Nothing
% structural changes and no row slices are involved.  `global sqrt` is dropped
% as an implicit intrinsic.
%
% WHAT parmve DOES, in PIC terms: bilinear ("area weight") interpolation of the
% field to each particle, a velocity kick, a position drift, a boundary check,
% and finally deposition of the particle charge back onto the grid using the
% same four weights.
%
% THE ORACLE.  The four area weights are w1 = fxc*fyc, w2 = fx*fyc,
% w3 = fxc*fy, w4 = fx*fy with fxc = 1-fx and fyc = 1-fy, so
%
%     w1 + w2 + w3 + w4 = (fxc + fx) * (fyc + fy) = 1
%
% EXACTLY, for any particle position.  That single identity underwrites both
% halves of the scheme and both of the sharpest checks here:
%
%   * GATHER.  With a UNIFORM field E the interpolated field is
%     E*(w1+w2+w3+w4) = E for every particle wherever it sits, so the velocity
%     kick is exactly dt*qmult/wmult*E.  An error in any weight, or a wrong grid
%     index, breaks it.
%   * SCATTER.  The deposition uses the same weights, so the TOTAL charge landing
%     on the grid equals the total particle charge -- charge is conserved by the
%     same partition of unity, in the opposite direction.
%
% Plus three properties of the push itself: a ZERO field leaves velocities
% untouched and drifts positions by exactly dt*v; dt = 0 is the identity (which
% is the configuration the benchmark's own main runs, since it sets dt := 0);
% and a particle with x < 0 is INACTIVE by the mover's own sentinel convention
% (`h := if x < 0 then 0 else 1`), so it must not move whatever the field or dt.

define main

type OneD = array_dv[double];
type OneI = array_dv[integer];

function BCNDUpdate2( lb,ibcdl:integer; x,xh,vx,vxh:OneD; 
                      xleft, xlef2:double 
                      returns OneD, OneD, OneD, OneD )
  if ( x[lb] >= xleft ) then x, vx, xh, vxh                % GOTO 60
  elseif ( ibcdl > 1 ) then                                % GOTO 30
    x, vx, xh, vxh                                         % call BCNDL GOTO 60
  else
    x[lb:xlef2 - x[lb]], vx[lb:-vx[lb]],
    if ( xh[lb] >= xleft ) then xh, vxh                    % GOTO 60
    else xh[lb:xlef2-xh[lb]], vxh[lb:-vxh[lb]] 
    end if
  end if
end function


function BCNDUpdate1( lb:integer; z_IN,zh_IN:OneD; zmax:double 
                     returns OneD, OneD )
let
  z  := z_IN[lb];
  zh := zh_IN[lb];
  
  zv, zhv := if ( z < zmax ) then                             % GOTO 70

               if ( z >= 0.0D0 ) then z, zh                   % GOTO 80
               else
                 let
                   zv := z + zmax;
                 in
                   if ( zh >= 0.0D0 ) then zv, zh             % GOTO 80
                   else zv, zh + zmax
                   end if
                 end let
               end if

             else

               let
                 zv1 := z - zmax;
               in
                 if ( zh < zmax ) then                         % GOTO 70
                   if ( zv1 >= 0.0D0 ) then zv1, zh            % GOTO 80
                   else
                     if ( zh >= 0.0D0 ) then zv1 + zmax, zh    % GOTO 80
                     else zv1 + zmax, zh + zmax
                     end if
                   end if
                 else zv1, zh - zmax
                 end if
               end let

             end if;
in
  z_IN[lb:zv], zh_IN[lb:zhv]
end let
end function


function BCND( xleft,xright:double;
               l3,jb:integer;
               kbound,ibcdr,ibcdl:integer;
               ib:OneI;
               yIN,yhIN,xIN,xhIN,vxIN,vxhIN:OneD;
               xmax,ymax:double;
               returns OneD, OneD, OneD, OneD, OneD, OneD )
let
  xlef2 := 2.0D0 * xleft;
  xrit2 := 2.0D0 * xright;
in
  for initial
    l   := l3;

    y   := yIN;
    yh  := yhIN;
    x   := xIN;
    xh  := xhIN;
    vx  := vxIN;
    vxh := vxhIN;

  while ( l <= jb ) repeat
    l  := old l + 1;
    lb := ib[old l];

    x, xh, vx, vxh :=
      if ( kbound = 0 ) then                                % GOTO 40

        BCNDUpdate1( lb, old x,old xh, xmax ), old vx, old vxh

      elseif ( old x[lb] < xright ) then                    % GOTO 20

        BCNDUpdate2( lb,ibcdl, old x,old xh,old vx,old vxh, xleft,xlef2 )

      elseif ( ibcdr > 1 ) then                             % GOTO 10

        old x, old xh, old vx, old vxh                      % call BCNDL GOTO 60

      else

        let
          x1  := old x[lb: xrit2-old x[lb]];
          vx1 := old vx[lb: -old vx[lb]]
        in
          if ( old xh[lb] < xright ) then % GOTO 20
            BCNDUpdate2( lb,ibcdl, x1,old xh,vx1, old vxh, xleft,xlef2 )
          else
            x1, old xh[lb: xrit2-old xh[lb]], vx1, old vxh[lb:-old vxh[lb]] 
          end if
        end let

      end if;

% 60:
    y, yh := BCNDUpdate1( lb, old y,old yh, ymax );
%               yIN,yhIN,xIN,xhIN,vxIN,vxhIN:OneD;
  returns value of y value of yh
          value of x value of xh
          value of vx value of vxh
  end for
end let
end function


function parmve( dt,qmult,wmult:double;
                 kbound,ibcdr,ibcdl,l3,l4:integer;
                 ex,ey:OneD;
                 xmax,ymax,xright,xleft,hxi,hyi:double; nx2:integer;
                 yIN,yh,xIN,xh,vxIN,vxh,vyIN,q:OneD;
                 returns OneD, OneD, OneD, OneD, OneD, OneD, OneD, OneD )
let
  h1 := dt*qmult/wmult;
  hh := 0.5D0*h1;

  h := for l in l3,l4
       returns array_dv of if (xIN[l] < 0.0D0 ) then 0.0D0 else h1 end if
       end for;

%
%
%    calculate area weight vectors
%

  i,  fx, fy, ij, 
  w1, w2, w3, w4 := for l in l3,l4
                      rx  := hxi*xIN[l] + 1.5D0;
                      ry  := hyi*yIN[l] + 1.5D0;
                      i   := integer(trunc(rx));            % i = rx
                      fx  := rx - double_real(trunc(rx)); % aint
                      fxc := 1.0D0 - fx;
                      j   := integer(trunc(ry));            % j = ry
                      fy  := ry - double_real(trunc(ry)); % aint
                      fyc := 1.0D0 - fy;
                    returns array_dv of i
                            array_dv of fx
                            array_dv of fy
                            array_dv of i + nx2*(j-1)
                            array_dv of fxc*fyc
                            array_dv of fx*fyc
                            array_dv of fxc*fy
                            array_dv of fx*fy
                    end for;

%  fetch ex field vector
%    calculate average field on particle
%
%     1ef4,nx2,324)
%
  exa, eya := for l in l3,l4
                ijl   := ij[l];
                ijl1  := ijl + 1;
                ijln  := ijl + nx2;
                ijln1 := ijln + 1;
              returns array_dv of w1[l]*ex[ijl] + w2[l]*ex[ijl1] + w3[l]*ex[ijln] +
                               w4[l]*ex[ijln1]
                      array_dv of w1[l]*ey[ijl] + w2[l]*ey[ijl1] + w3[l]*ey[ijln] +
                               w4[l]*ey[ijln1]
              end for;
%
%  advance two components of velocity
%
  vx, vy := for l in l3,l4
            returns array_dv of vxIN[l] + h[l]*exa[l]
                    array_dv of vyIN[l] + h[l]*exa[l]
            end for;
%
%   advance whole positions.
%
  h2, x, y := for l in l3,l4
                h := if ( xIN[l] < 0.0D0 ) then 0.0D0 else 1.0D0 end if;
              returns array_dv of h
                      array_dv of xIN[l] + dt*vx[l]*h
                      array_dv of yIN[l] + dt*vy[l]*h
              end for;
%
%   check for particle boundary crossings
%
  jb, ib := for l in l3,l4
              ib := if (x[l] >= xright) then 1
                    elseif (x[l] < xleft) then 1
                    elseif (y[l] < 0.0D0) then 1
                    elseif (y[l] >= ymax) then 1
                    else 0
                    end if;
            returns value of sum ib
                    array_dv of ib
            end for;

  y1, yh1, x1, 
  xh1, vx1, vxh1 := if ( jb > 0 ) then
                      BCND( xleft,xright, l3,jb, kbound,ibcdr,ibcdl, ib,
                            y, yh, x, xh, vx, vxh, xmax, ymax )
                    else
                      y, yh, x, xh, vx, vxh
                    end if;
%
%    calculate area weight vectors at whole time
%
  qmlt := for l in l3,l4
            qmlt := if (x1[l] < 0.0D0 ) then 0.0D0 else qmult end if;
          returns array_dv of qmlt
          end for;

  i1, fx1, fy1, ij1,
  w11, w21, w31, w41 := for l in l3,l4
                          rx  := hxi*x1[l] + 1.5D0;
                          ry  := hyi*y1[l] + 1.5D0;
                          i   := integer(trunc(rx));
                          fx  := rx - double_real(trunc(rx));
                          fxc := 1.0D0 - fx;
                          j   := integer(trunc(ry));
                          fy  := ry - double_real(trunc(ry));
                          fyc := 1.0D0 - fy;
                        returns array_dv of i
                                array_dv of fx
                                array_dv of fy
                                array_dv of i + nx2*(j-1)
                                array_dv of fxc*fyc
                                array_dv of fx*fyc
                                array_dv of fxc*fy
                                array_dv of fx*fy
                         end for;
%
%  area weight particles onto charge grid
%
  s1, s2, s3, s4 := for l in l3,l4
                    returns array_dv of w11[l]*qmlt[l]
                            array_dv of w21[l]*qmlt[l]
                            array_dv of w31[l]*qmlt[l]
                            array_dv of w41[l]*qmlt[l]
                    end for;

  q1 := for initial
          l  := l3;
          q1 := q;
        while ( l <= l4 ) repeat
          l  := old l + 1;

          ijl   := ij1[old l];
          ijl1  := ijl + 1;
          ijln  := ijl + nx2;
          ijln1 := ijln + 1;

          q1a := old q1[ijl:  old q1[ijl] + s1[old l]];
          q1b := q1a[ijl1: q1a[ijl1] + s2[old l]];
          q1c := q1b[ijln: q1b[ijln] + s3[old l]];

          q1  := q1c[ijln1: q1c[ijln1] + s4[old l]];
        returns value of q1
        end for;
in
  y1, yh1, x1, xh1, vx1, vxh1, vy, q1
end let
end function


function main( ex, ey : OneD;
               y, yh, x, xh, vx, vxh, vy, q : OneD;
               l3, l4, nx2, kbound, ibcdr, ibcdl : integer;
               dt, qmult, wmult, xmax, ymax, xright, xleft, hxi, hyi : double
      returns OneD, OneD, OneD, OneD, OneD, OneD, OneD, OneD )
  parmve( dt, qmult, wmult, kbound, ibcdr, ibcdl, l3, l4, ex, ey,
          xmax, ymax, xright, xleft, hxi, hyi, nx2,
          y, yh, x, xh, vx, vxh, vy, q )
end function
