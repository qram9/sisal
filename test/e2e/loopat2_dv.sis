% Origin: test/unit/tst_loopAt2.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% Hydro Fragment
% Parallel Algorithm

Define  Main

%type double = double_real;
type OneD   = array_dv[double];

function Main(N:Integer; Y:OneD returns OneD )
   for I in 1,N
   returns array_dv of Y[I]*Y[I]
   end for
end function

