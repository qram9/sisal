% Origin: test/unit/tagcase_bare.sis
% Port Note: uses list pattern / union node representation for unavoidable ragged structures.
%
% Bare tagcase forms — `tagcase <expr>` with NO payload binding (X :=).
% The arms cannot reference the payload; only the tag dispatch matters.
% Covers: selector = let-bound variable, function parameter, call result,
% otherwise arm, and the `is Tag(e)` test.
define Main

type UN = union[ A: integer; B: real; C: boolean ]

function DispatchParam( u: UN returns integer )
  tagcase u
  tag A: 1
  tag B: 2
  otherwise: 9
  end tagcase
end function

function Mk( s: integer returns UN )
  if s = 1 then union UN[ A: 42 ] else union UN[ B: 3.14 ] end if
end function

function Main( s: integer returns integer, integer, integer, boolean )
  let
    u  := Mk( s );
    r1 := tagcase u
          tag A: 10
          tag B: 20
          otherwise: 90
          end tagcase;
    r2 := tagcase Mk( s + 1 )
          tag A: 100
          tag B: 200
          otherwise: 900
          end tagcase
  in
    r1, r2, DispatchParam( u ), is A( u )
  end let
end function
