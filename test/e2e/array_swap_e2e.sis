% Origin: test/unit/mat2_ops.sis
% Port Note: adapted for rank-polymorphic e2e execution.
%
define Main

type IntArray = array_dv[integer]

function Main(A, B : IntArray returns IntArray, IntArray)
    let
        Temp := A;
        A_swapped := B;
        B_swapped := Temp
    in
        A_swapped, B_swapped
    end let
end function
