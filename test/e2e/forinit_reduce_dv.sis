% Origin: test/unit/for_initial.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% Reductions in a SEQUENTIAL loop: `for initial ... returns value of sum/product/
% least/greatest X`.  A forall has had these all along; a for-initial had only
% FINALVALUE (`value of X`) and gathers (`array_dv of X`), so a REDUCE node in its
% RETURNS hit the generic node lowering and failed.
%
% The operator statements are shared with the forall path (emit_reduction), and
% the correctness bar is that a reduction must AGREE with a gather over the same
% loop: `returns array_dv of X` collects the value history, so `value of sum X` must
% equal its sum.  For a CARRY that history starts with the SEED -- the gather
% stores it in the preheader before the first iteration -- so the fold has to
% include it too.
%
%   i := 1 while i <= 10 repeat i := old i + 1
%     gather   -> [1,2,3,...,11]   (11 values: the seed, then each update)
%     sum      -> 66     product -> 39916800 (=11!)
%     greatest -> 11     least   -> 1
%
% The second loop reduces a BODY-COMPUTED value rather than the induction
% variable: c is 0/1 by parity, history [0, 0,1,0,1,0], so sum is 2.
define main

type A = array_dv[integer];

function SumI( returns integer )
  for initial i := 1 while i <= 10 repeat i := old i + 1
  returns value of sum i end for
end function

function ProdI( returns integer )
  for initial i := 1 while i <= 10 repeat i := old i + 1
  returns value of product i end for
end function

function GreatestI( returns integer )
  for initial i := 1 while i <= 10 repeat i := old i + 1
  returns value of greatest i end for
end function

function LeastI( returns integer )
  for initial i := 1 while i <= 10 repeat i := old i + 1
  returns value of least i end for
end function

% the same loop gathered, so the test can check reduction == sum(gather)
function GatherI( returns A )
  for initial i := 1 while i <= 10 repeat i := old i + 1
  returns array_dv of i end for
end function

% a body-computed (non-monotone) value, not the induction variable
function SumParity( returns integer )
  for initial
    i := 1;
    c := 0
  while i <= 5 repeat
    c := if mod( old i, 2 ) = 0 then 1 else 0 end if;
    i := old i + 1
  returns value of sum c
  end for
end function

function main( returns integer, integer, integer, integer, A, integer )
  SumI(), ProdI(), GreatestI(), LeastI(), GatherI(), SumParity()
end function
