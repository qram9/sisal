% Origin: test/unit/IFm_2ETC.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% IFACTm_2ETC -- the radix-2 (and general "2 etc") butterfly pass of the FFT,
% from test/unit/IFm_2ETC.sis, ported to array_dv.  One of the three kernels
% PassFreq / PassGrid declare as `global` externs, which is the only reason
% those two cannot be promoted; this is the first of them.
%
% Parameters come from the caller as PassFreq derives them:
%     m := n / ifac;  jink := inc2 * m;  iink := inc1 * la;
%     jump := (ifac - 1) * iink
% with ifac = 2 here.
%
% What this covers that nothing else in the suite does:
%
%   * a NESTED for-initial whose carry is an ARRAY -- the outer loop carries
%     (ia, ja, c) over k, and each of the three arms carries (ia1, ja1, c1) over
%     l, with c/c1 the array being built.  `value of` on an array carry, at two
%     levels.
%   * MULTI-VALUE array replace: `c1[ja1 : v1; jbxx : v2; ja1+1 : v3;
%     jbxx+1 : v4]` updates four positions in one expression.
%   * a three-way IF whose result is a TUPLE of (integer, integer, array) --
%     the array component riding a multi-value conditional.
%   * `real` (single precision) elements rather than double.
%
% The reference in the harness is the same butterfly transcribed to C.  Index
% arithmetic this dense is exactly where a transcription slips, so it is
% cross-checked against OSC 13.0.3 on the same inputs -- and OSC's runtime
% subscript checking is what confirms the driver's array sizes are large enough,
% since we would read past the end silently.

DEFINE Main

type ArrReal1 = array_dv[real]

function Main(m, la, iink, jink, jump, inc1, inc2 : integer; 
		    a, ci, trigs : ArrReal1 
		    RETURNS ArrReal1)
FOR INITIAL
k := 0;
ia := 1;
ja := 1;
c := ci;

WHILE k <= m / 2 REPEAT
k := old k + la;
ia, ja, c := 
  IF old k = 0
  THEN 	LET ia1, ja1, c1 := 

	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jb := old ja1 + jink;
	c1 := old c1[old ja1 : a[old ia1] + a[ib]; jb : a[old ia1]-a[ib]] 

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSEIF 2 * old k < m 
THEN	LET ia1, ja1, c1 := 

	FOR INITIAL
	kb := old k * 2;
	lower := jink + 2;
	lupper := iink * 2 + jink - 2;
	l := lower;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE l <= lupper REPEAT
	l := old l + 4;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	jbxx := old l - old ja1;
	tempr := a[ib] * trigs[kb + 1] - a[ib + 1] * trigs[kb + 2];
	tempi := a[ib] * trigs[kb + 2] + a[ib + 1] * trigs[kb + 1];
	c1 := old c1[old ja1 : a[old ia1] + tempr;
		   jbxx : a[old ia1] - tempr; 
		   old ja1 + 1 : a[old ia1 + 1] + tempi; 
		   jbxx + 1 : tempi - a[old ia1 + 1]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

	IN ia1 + jump, ja1, c1
	END LET

ELSE	FOR INITIAL
	l := 1;
	ia1 := old ia;
	ja1 := old ja;
	c1 := old c;

	WHILE  l <= la REPEAT
	l := old l + 1;
	ia1 := old ia1 + inc1;
	ja1 := old ja1 + inc2;
	ib := old ia1 + iink;
	c1 := old c1[old ja1 : a[old ia1]; old ja1 + 1 : - a[ib]];

	RETURNS VALUE of ia1
		VALUE of ja1
		VALUE of c1
	END FOR

END IF;

RETURNS VALUE of c
END FOR
end function
