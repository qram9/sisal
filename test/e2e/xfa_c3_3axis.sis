% Origin: test/unit/reshape_3d.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main
function main(a, b, c: integer returns array_dv[integer])
  for i in 1, a cross j in 1, b cross k in 1, c
  returns array_dv of i * j * k
  end for
end function
