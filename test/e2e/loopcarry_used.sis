% Origin: test/unit/loop1.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main
function Main( n: integer; Ain: array_dv[double] returns array_dv[double] )
  for initial
    I := 0;
    A := Ain
  while I < n repeat
    I := old I + 1;
    A := for i in 1, n returns array_dv of old A[i] * 2.0d0 end for
  returns value of A
  end for
end function
