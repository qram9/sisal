% Origin: test/unit/builtin_vec.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main

type OneD = array_dv[double_real];

% Test lifted arithmetic on Array_dv.
% Should produce Array_dv results and include conformity checks.
function main(A, B: OneD returns OneD)
  A * B + A
end function
