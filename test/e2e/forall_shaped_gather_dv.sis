% Origin: test/unit/masked_cross_gather.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define Main

type ArrReal1 = array_dv[real];
type ArrReal2 = array_dv[real];

function Main(n, m : integer RETURNS ArrReal2)
    FOR i IN 1, n
        row := FOR j IN 1, m
               RETURNS array_dv of real(i * 10 + j)
               END FOR
    RETURNS array_dv(m) of row
    END FOR
end function
