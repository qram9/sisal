% Conway-variant Life from test/unit/life1.sis, ported to array_dv.  Distinct
% from the covered life2_dv, which is a FLAT CROSS forall over the padded grid:
% this one uses NESTED foralls and rebuilds the border explicitly, so it
% exercises array_addl / array_addh at TWO RANKS -- 1-D on each row, then rank-2
% on the grid, where the appended element is a whole ROW.
%
% Two things the port has to get right, both about what an array_dv IS -- a flat
% buffer plus a dope vector, with RANK a runtime property that never appears in
% the element type:
%
%   * a rank-2 grid and a rank-1 row are BOTH `array_dv[integer]`.
%     `array_dv[array_dv[integer]]` cannot be written; an array_dv is never
%     directly inside another.  (Rank-k literals are built flat and reshaped --
%     `reshape(array_dv Flat [1: ...], r, c)`; see reshape_dv.sis.)
%   * a ROW is `G[I, ..]`, not `G[I]`.  The trailing `..` is the rank-reduce;
%     a bare `G[I]` selects an element.
%
% Getting the second wrong is SILENT here rather than fatal, which is worth
% knowing: the row feeds array_addh, so the border is appended as ONE element
% instead of Columns+2 and DoWork returns rank=2 dims=0,0 size=20 where 5x6=30
% is right -- 20 = 18 + 1 + 1.
%
% The outer driver is a for-initial whose carry is the whole GRID, advanced Num
% generations by a call, so it also covers an array-valued carry threaded
% through a function call and read back with `value of` -- including the
% zero-trip case (Num=0 returns the seed grid unchanged).
%
% The transition rule is the source's, which is NOT standard Conway:
%     alive and Total > 5  -> 0
%     otherwise Total ~= 3 -> 1
%     otherwise            -> 0
% Reproduced exactly rather than corrected; the reference implements the same.

define Main

% Rank is a RUNTIME property of the dope vector, so a rank-2 grid and a rank-1
% row are both spelled array_dv[integer]; a nested array_dv[array_dv[..]] is the
% shape the model forbids (and the compiler rejects here outright).
type   OneDim  = array_dv[integer];
type     Grid  = array_dv[integer];

function Compute( G : Grid; I : integer; J : integer returns integer )
    let
        Total := G[I+1,J-1] + G[I+1,J] + G[I+1,J+1] + 
	         G[I-1,J-1] + G[I-1,J] + G[I-1,J+1] +
                 G[I,J-1]   + G[I,J+1];
    in
        if ( G[I,J] = 1 & Total > 5 ) then 0 
	ELSEIF ( Total ~= 3 ) then 1 else 0 end if
    end let
end function

function DoWork( G : Grid; Rows, Columns : integer returns Grid )
    let
	Clast  := Columns + 1;
	Rlast  := Rows    + 1;
	Middle := for I in 1, Rows
		      Mid := for J in 1, Columns
				 V := Compute( G, I, J );
			     returns array_dv of V
			     end for;
                      Row := array_addl( Mid, G[I,0] );
                  returns array_dv of array_addh( Row, G[I,Clast] )
		  end for;
    in
	array_addl( array_addh( Middle, G[Rlast, ..] ), G[0, ..] )
    end let
end function

function Main( Num, Rows, Columns : integer; G : Grid returns Grid )
    for initial
	Count := Num;
	NewG  := G
    while ( Count > 0 ) repeat
	Count := old Count - 1;
	NewG  := DoWork( old NewG, Rows, Columns ); 
    returns value of NewG
    end for
end function
