% Origin: test/unit/tst_loop1.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
% Hydro Fragment
% Parallel Algorithm
% DV variant: returns array_dv of signals monolithic pre-allocated output
Define  Main

%type double = double_real;
type OneD   = array_dv[double];
type OneDV  = array_dv[double];

function Main( n:integer; Q,R,T:double; Y,Z:OneD returns OneDV )
   for K in Y
       X := K+K
   returns array_dv of X
   end for
end function
