% Origin: test/unit/tuple_add.sis
% Port Note: uses rank-polymorphic array_dv (flat dope-vector) instead of unit ragged array (array_dv[array_dv[...]]).
%
define main

function tuple_add(A, B : array_dv[real] returns array_dv[real])
  let
    na := array_size(A);
    nb := array_size(B);
  in
    if na = nb then
      for IA in A dot IB in B
        returns array_dv of IA + IB
      end for
    elseif na = 1 then
      let a0 := A[array_liml(A)]; in
        for IB in B
          returns array_dv of a0 + IB
        end for
      end let
    elseif nb = 1 then
      let b0 := B[array_liml(B)]; in
        for IA in A
          returns array_dv of IA + b0
        end for
      end let
    else
      error[array_dv[real]]
    end if
  end let
end function
