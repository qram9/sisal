% Origin: test/unit/Spec.sis
% Port Note: Spectral to frequency sphere grid transform ported to e2e rank-polymorphic array_dv.
%
define Main

type ArrInt1 = array_dv[integer];
type ArrReal1 = array_dv[real];
type ArrReal3 = array_dv[real];

function Main
        ( jx, mx, jxx, ilath, ixh : integer; kmjx, kmjxx : ArrInt1; 
          alp : ArrReal3; pri, zri, uri, vri : ArrReal1
          returns ArrReal3, ArrReal3, ArrReal3, ArrReal3 )
  let
    pg, zg, ug, vg :=
      for hemi in 1, 2 cross latlev in 1, ilath cross mrmi in 1, mx * 2
        m := (mrmi + 1) / 2;
        
        pg_val, zg_val :=
          for j in 1, jx
            jm := kmjx[m] + j;
            jmx := kmjxx[m] + j;
            jmrjmi := jm * 2 - mod(mrmi, 2);
            pgj, zgj := if ~(m = 1 & j = 1)
                        then alp[hemi, latlev, jmx] * pri[jmrjmi],
                             alp[hemi, latlev, jmx] * zri[jmrjmi]
                        else 0.0, 0.0
                        end if;
          returns value of sum pgj
                  value of sum zgj
          end for;

        ug_val, vg_val :=
          for j in 1, jxx
            jmx := kmjxx[m] + j;
            jmrjmi := jmx * 2 - mod(mrmi, 2);
          returns value of sum alp[hemi, latlev, jmx] * uri[jmrjmi]
                  value of sum alp[hemi, latlev, jmx] * vri[jmrjmi]
          end for;

      returns array_dv of pg_val
              array_dv of zg_val
              array_dv of ug_val
              array_dv of vg_val
      end for;
  in
    pg, zg, ug, vg
  end let
end function
