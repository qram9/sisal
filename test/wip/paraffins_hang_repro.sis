define main
type Radical  = union[ Hydrogen: null; Carbon: array_dv[ Radical ] ]
type Paraffin = array_dv[ Radical ]
function Para( N: integer returns Paraffin )
  if N = 0 then array_dv Paraffin[ 1: union Radical[ Hydrogen: nil ] ]
  else
    for i in 0,(N-1)/3 cross j in i,(N-1-i)/2
      k := N-1-i-j;
      OneSet := for R1 in Para( i ) cross R2 in Para( j ) cross R3 in Para( k )
          Rad := array_dv Paraffin[ 1: union Radical[ Carbon: array_dv Paraffin[ 1: R1, R2, R3 ] ] ]
        returns value of catenate Rad end for
    returns value of catenate OneSet end for
  end if
end function
function main( n: integer returns Paraffin )
  for R in Para( 1 ) returns value of catenate (array_dv Paraffin[ 1: R ]) end for
end function
