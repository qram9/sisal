define Main

function Main(
    selector: integer;
    flag: boolean;
    val1: integer;
    val2: integer;
    val3: integer
    returns integer
)
    let
        % 1. First nested if-else that captures different outer scope values
        first_result := if selector = 1 then
                            if flag then
                                val1
                            else
                                val2
                            end if
                        else
                            val3
                        end if;
    in
        % 2. Give the let var (first_result) to another if-else and return it
        if first_result > 50 then
            first_result * 2
        else
            first_result + 100
        end if
    end let
end function
